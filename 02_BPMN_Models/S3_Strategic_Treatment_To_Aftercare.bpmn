<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_S3_TreatmentToAftercare" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Msg_AuthorisedTreatmentRequest" name="Authorised treatment booking request"></bpmn:message>
  <bpmn:message id="Msg_TreatmentCapacityRequest" name="Treatment capacity request"></bpmn:message>
  <bpmn:message id="Msg_TreatmentCapacityResponse" name="Treatment capacity response"></bpmn:message>
  <bpmn:message id="Msg_FundingApprovalRequest" name="Funding approval request"></bpmn:message>
  <bpmn:message id="Msg_FundingApprovalResponse" name="Funding approval response"></bpmn:message>
  <bpmn:message id="Msg_SecurePaymentRequest" name="Secure payment request"></bpmn:message>
  <bpmn:message id="Msg_PaymentStatus" name="Payment status"></bpmn:message>
  <bpmn:message id="Msg_RefundRequest" name="Refund request"></bpmn:message>
  <bpmn:message id="Msg_BloodTestRequest" name="Blood test and clinical assessment request"></bpmn:message>
  <bpmn:message id="Msg_ClinicalCorrespondence" name="Clinical correspondence"></bpmn:message>
  <bpmn:message id="Msg_FollowUpAppointmentRequest" name="Follow-up appointment request"></bpmn:message>
  <bpmn:message id="Msg_FollowUpAppointmentResponse" name="Follow-up appointment response"></bpmn:message>
  <bpmn:message id="Msg_PatientNotAttending" name="Patient cancellation or non-attendance"><bpmn:extensionElements><zeebe:subscription correlationKey="=patientId" /></bpmn:extensionElements></bpmn:message>
  <bpmn:message id="Msg_PatientEnquiry" name="Patient enquiry"></bpmn:message>
  <bpmn:collaboration id="Collaboration_S3" name="S3 | Strategic collaboration: treatment, correspondence, enquiries and aftercare">
    <bpmn:participant id="P_Hospital" name="Specialist Hospital Service (Hospital Patient Administration System)" processRef="PR_TreatmentToAftercare" />
    <bpmn:participant id="P_Enquiries" name="Hospital Patient Administration System - patient enquiry handling" processRef="PR_EnquiryHandling" />
    <bpmn:participant id="P_Reporting" name="Hospital Patient Administration System - management reporting" processRef="PR_ManagementReporting" />
    <bpmn:participant id="P_Patient" name="Patient / Authorised Representative" />
    <bpmn:participant id="P_ClinicalServices" name="External Clinical Services (treatment, laboratory, imaging)" />
    <bpmn:participant id="P_FundingOrganisation" name="Funding Organisation / Insurer" />
    <bpmn:participant id="P_PaymentProvider" name="External Payment Service Provider" />
    <bpmn:participant id="P_Correspondence" name="External Correspondence Service" />
    <bpmn:participant id="P_Scheduling" name="External Scheduling Service" />
    <bpmn:messageFlow id="MF_1" name="Treatment capacity request" sourceRef="T_RequestTreatmentCapacity" targetRef="P_ClinicalServices" messageRef="Msg_TreatmentCapacityRequest" />
    <bpmn:messageFlow id="MF_2" name="Treatment capacity response" sourceRef="P_ClinicalServices" targetRef="T_RequestTreatmentCapacity" messageRef="Msg_TreatmentCapacityResponse" />
    <bpmn:messageFlow id="MF_3" name="Blood test and assessment request" sourceRef="T_RequestBloodTest" targetRef="P_ClinicalServices" messageRef="Msg_BloodTestRequest" />
    <bpmn:messageFlow id="MF_4" name="Funding approval request" sourceRef="T_RequestFundingApproval" targetRef="P_FundingOrganisation" messageRef="Msg_FundingApprovalRequest" />
    <bpmn:messageFlow id="MF_5" name="Funding approval response" sourceRef="P_FundingOrganisation" targetRef="T_RequestFundingApproval" messageRef="Msg_FundingApprovalResponse" />
    <bpmn:messageFlow id="MF_6" name="Secure payment request" sourceRef="T_RequestSecurePayment" targetRef="P_PaymentProvider" messageRef="Msg_SecurePaymentRequest" />
    <bpmn:messageFlow id="MF_7" name="Payment status" sourceRef="P_PaymentProvider" targetRef="T_RequestSecurePayment" messageRef="Msg_PaymentStatus" />
    <bpmn:messageFlow id="MF_8" name="Refund request" sourceRef="T_RequestRefund" targetRef="P_PaymentProvider" messageRef="Msg_RefundRequest" />
    <bpmn:messageFlow id="MF_9" name="Clinical correspondence" sourceRef="T_DistributeClinicLetter" targetRef="P_Correspondence" messageRef="Msg_ClinicalCorrespondence" />
    <bpmn:messageFlow id="MF_10" name="Follow-up appointment request" sourceRef="T_ArrangeFollowUp" targetRef="P_Scheduling" messageRef="Msg_FollowUpAppointmentRequest" />
    <bpmn:messageFlow id="MF_11" name="Follow-up appointment response" sourceRef="P_Scheduling" targetRef="T_ArrangeFollowUp" messageRef="Msg_FollowUpAppointmentResponse" />
    <bpmn:messageFlow id="MF_12" name="Patient cancellation or non-attendance" sourceRef="P_Patient" targetRef="B_NotAttending" messageRef="Msg_PatientNotAttending" />
    <bpmn:messageFlow id="MF_13" name="Patient enquiry" sourceRef="P_Patient" targetRef="E_EnquiryReceived" messageRef="Msg_PatientEnquiry" />
  </bpmn:collaboration>
  <bpmn:process id="PR_TreatmentToAftercare" name="Treatment funding, delivery, correspondence and aftercare" isExecutable="true">
    <bpmn:laneSet id="PR_TreatmentToAftercare_laneSet">
      <bpmn:lane id="L_TB" name="Treatment &amp; Chemotherapy Bookings Team">
        <bpmn:flowNodeRef>E_AuthorisedRequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_TreatmentRequestManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ValidateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestTreatmentCapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CapacityConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_KeepPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ConfirmTreatmentSchedule</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_FIN" name="Finance Team">
        <bpmn:flowNodeRef>T_DetermineFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FundingApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordFundingApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestFundingApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_AdvancePaymentRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestSecurePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PaymentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_HandlePaymentFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_MarkForInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ResolveTransaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReferUnconfirmedPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FinancialImpact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReviewFinancialImpact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RefundDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestRefund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordRefund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CT" name="Consultant / Clinical Team">
        <bpmn:flowNodeRef>T_AuthoriseUrgentTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DeliverTreatmentCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FurtherCycles</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestBloodTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReviewCycleResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FitnessToContinue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ModifyTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_UrgentPostponement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ApplyTreatmentChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PrepareClinicLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_LetterDelayed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ApproveClinicLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_LetterApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CompletePathway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_PathwayComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_MS" name="Medical Secretaries">
        <bpmn:flowNodeRef>T_AdministrativeCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ClinicalError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CommunicationPreference</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PrepareAccessibleFormat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_DistributeClinicLetter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_OB" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>T_ArrangeFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FollowUpWithinPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ConfirmFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_NotAttending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordNonAttendance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PaymentOnAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_OfferAnotherAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_PathwayReviewed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PPC" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>T_WeeklyReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReminderInterval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_LetterAge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_HighlightFollowUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_FollowUpEscalated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_AM" name="Administrative Management">
        <bpmn:flowNodeRef>T_EscalateToManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_LetterAgeExtended</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EscalateToHigherManagement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_DelayedCorrespondence</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E_AuthorisedRequestReceived" name="Authorised treatment booking request received">
      <bpmn:documentation>Continues S2: only a request authorised by an appropriate clinical professional reaches this process.</bpmn:documentation>
      <bpmn:outgoing>F_D1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E_AuthorisedRequestReceived_msgdef" messageRef="Msg_AuthorisedTreatmentRequest" />
    </bpmn:startEvent>
    <bpmn:startEvent id="E_TreatmentRequestManual" name="Treatment request received (manual start)">
      <bpmn:documentation>The same authorised request, started by hand rather than by the incoming message, so the process can be run from the Operate or Tasklist user interface.</bpmn:documentation>
      <bpmn:outgoing>F_D1m</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_ValidateRequest" name="Validate the authorised request and confirm resource requirements">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-validate-treatment-request" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D1</bpmn:incoming>
      <bpmn:incoming>F_D1m</bpmn:incoming>
      <bpmn:outgoing>F_D2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_RequestTreatmentCapacity" name="Request treatment appointments from external clinical services">
      <bpmn:documentation>Some appointments use hospital facilities; others depend on external treatment, laboratory or imaging services.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:taskDefinition type="request-treatment-capacity" /></bpmn:extensionElements>
      <bpmn:incoming>F_D2</bpmn:incoming>
      <bpmn:incoming>F_D6</bpmn:incoming>
      <bpmn:outgoing>F_D3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_CapacityConfirmed" name="External treatment capacity confirmed?" default="F_D4">
      <bpmn:incoming>F_D3</bpmn:incoming>
      <bpmn:outgoing>F_D4</bpmn:outgoing>
      <bpmn:outgoing>F_D5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_KeepPending" name="Keep the booking pending, notify the responsible team and record the retry">
      <bpmn:documentation>A pending booking must not create duplicate appointments.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-record-pending-booking" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D4</bpmn:incoming>
      <bpmn:outgoing>F_D6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_DetermineFunding" name="Determine the funding route: hospital funded, approved insurer or patient payable">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-determine-funding-route" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D5</bpmn:incoming>
      <bpmn:incoming>F_D10</bpmn:incoming>
      <bpmn:outgoing>F_D7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_FundingApproved" name="Funding approved or no payment required?" default="F_D8">
      <bpmn:incoming>F_D7</bpmn:incoming>
      <bpmn:outgoing>F_D8</bpmn:outgoing>
      <bpmn:outgoing>F_D9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_RecordFundingApproval" name="Record the funding organisation, authorisation reference, approved amount and limitations">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-record-funding-approval" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D9</bpmn:incoming>
      <bpmn:outgoing>F_D11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RequestFundingApproval" name="Request funding approval or additional payment">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-request-funding-approval" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D8</bpmn:incoming>
      <bpmn:outgoing>F_D10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_AdvancePaymentRequired" name="Advance payment required before confirmation?" default="F_D12">
      <bpmn:documentation>Most eligible patients make no direct payment; charges may apply to private patients or non-covered treatment.</bpmn:documentation>
      <bpmn:incoming>F_D11</bpmn:incoming>
      <bpmn:outgoing>F_D12</bpmn:outgoing>
      <bpmn:outgoing>F_D13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_RequestSecurePayment" name="Send the secure payment request to the External Payment Service Provider">
      <bpmn:documentation>Complete card details are never stored in the hospital system.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:taskDefinition type="request-secure-payment" /></bpmn:extensionElements>
      <bpmn:incoming>F_D13</bpmn:incoming>
      <bpmn:incoming>F_D17</bpmn:incoming>
      <bpmn:outgoing>F_D14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_PaymentOutcome" name="Payment outcome returned by the payment service?" default="F_D16">
      <bpmn:incoming>F_D14</bpmn:incoming>
      <bpmn:outgoing>F_D15</bpmn:outgoing>
      <bpmn:outgoing>F_D16</bpmn:outgoing>
      <bpmn:outgoing>F_D18</bpmn:outgoing>
      <bpmn:outgoing>F_D21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_RecordPayment" name="Record the payment reference, amount and date against the patient account">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-record-payment" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D15</bpmn:incoming>
      <bpmn:outgoing>F_D25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_HandlePaymentFailure" name="Notify the patient and the responsible team and allow a further attempt without a duplicate booking">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-handle-payment-failure" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D16</bpmn:incoming>
      <bpmn:outgoing>F_D17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_MarkForInvestigation" name="Mark the transaction for investigation and do not raise a second payment">
      <bpmn:documentation>Used where the provider took the payment but the confirmation was lost in transit.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-mark-payment-investigation" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D18</bpmn:incoming>
      <bpmn:outgoing>F_D19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_AuthoriseUrgentTreatment" name="Authorise urgent treatment without confirmed payment and record the reason">
      <bpmn:documentation>Clinical staff may proceed where delaying care creates a patient risk; the reason must be recorded.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-authorise-urgent-treatment" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D21</bpmn:incoming>
      <bpmn:outgoing>F_D22</bpmn:outgoing>
      <bpmn:outgoing>F_D23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ResolveTransaction" name="Resolve the outstanding transaction with the payment provider or funding organisation">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-resolve-payment-transaction" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D19</bpmn:incoming>
      <bpmn:outgoing>F_D20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ReferUnconfirmedPayment" name="Refer the unconfirmed payment to the Finance Team for later resolution">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-refer-unconfirmed-payment" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D23</bpmn:incoming>
      <bpmn:outgoing>F_D24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ConfirmTreatmentSchedule" name="Confirm the treatment schedule and issue the patient instructions">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-confirm-treatment-schedule" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_D12</bpmn:incoming>
      <bpmn:incoming>F_D20</bpmn:incoming>
      <bpmn:incoming>F_D22</bpmn:incoming>
      <bpmn:incoming>F_D24</bpmn:incoming>
      <bpmn:incoming>F_D25</bpmn:incoming>
      <bpmn:outgoing>F_E1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_DeliverTreatmentCycle" name="Deliver the treatment cycle and record clinical administration">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-deliver-treatment-cycle" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_E1</bpmn:incoming>
      <bpmn:incoming>F_E5</bpmn:incoming>
      <bpmn:incoming>F_E13</bpmn:incoming>
      <bpmn:outgoing>F_E0</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_FurtherCycles" name="Further treatment cycles planned?" default="F_E2">
      <bpmn:incoming>F_E0</bpmn:incoming>
      <bpmn:outgoing>F_E2</bpmn:outgoing>
      <bpmn:outgoing>F_E3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_RequestBloodTest" name="Request the pre-cycle blood test and clinical assessment">
      <bpmn:extensionElements><zeebe:taskDefinition type="request-blood-test" /></bpmn:extensionElements>
      <bpmn:incoming>F_E3</bpmn:incoming>
      <bpmn:outgoing>F_E4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_ReviewCycleResults" name="Review the results and confirm whether the patient is fit to continue">
      <bpmn:documentation>These are clinical decisions; the bookings and finance teams cannot make them.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-review-cycle-results" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_E4</bpmn:incoming>
      <bpmn:outgoing>F_E4b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_FitnessToContinue" name="Patient fit to continue as planned?" default="F_E6">
      <bpmn:incoming>F_E4b</bpmn:incoming>
      <bpmn:outgoing>F_E5</bpmn:outgoing>
      <bpmn:outgoing>F_E6</bpmn:outgoing>
      <bpmn:outgoing>F_E7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ModifyTreatment" name="Raise and authorise a Treatment Modification Request">
      <bpmn:documentation>Requests made only by email or telephone must not be processed: changes must be formally authorised and auditable.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-treatment-modification-request" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_E6</bpmn:incoming>
      <bpmn:incoming>F_E8</bpmn:incoming>
      <bpmn:outgoing>F_E12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_UrgentPostponement" name="Record the urgent postponement for patient safety and obtain retrospective authorisation">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-urgent-postponement" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_E7</bpmn:incoming>
      <bpmn:outgoing>F_E8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_FinancialImpact" name="Modification affects an existing charge, funding approval or payment?" default="F_E9">
      <bpmn:incoming>F_E12</bpmn:incoming>
      <bpmn:outgoing>F_E9</bpmn:outgoing>
      <bpmn:outgoing>F_E10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ReviewFinancialImpact" name="Review the financial implications and update the funding or payment record">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-review-financial-impact" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_E10</bpmn:incoming>
      <bpmn:outgoing>F_E11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ApplyTreatmentChange" name="Apply the authorised change and update the treatment schedule">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-apply-treatment-change" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_E9</bpmn:incoming>
      <bpmn:incoming>F_E11</bpmn:incoming>
      <bpmn:outgoing>F_E13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_PrepareClinicLetter" name="Prepare the clinic letter">
      <bpmn:documentation>Describes the consultation, diagnosis, clinical findings, treatment decisions and follow-up arrangements.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-prepare-clinic-letter" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_E2</bpmn:incoming>
      <bpmn:incoming>F_F3</bpmn:incoming>
      <bpmn:incoming>F_F5</bpmn:incoming>
      <bpmn:outgoing>F_F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_LetterDelayed" name="Clinic letter not approved within seven days" attachedToRef="T_PrepareClinicLetter" cancelActivity="false">
      <bpmn:documentation>Non-interrupting: pathway monitoring starts while the Consultant still owes the letter.</bpmn:documentation>
      <bpmn:outgoing>F_F8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_LetterDelayed_timerdef"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="T_ApproveClinicLetter" name="Approve the clinical content of the clinic letter">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-approve-clinic-letter" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_F1</bpmn:incoming>
      <bpmn:outgoing>F_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_LetterApproved" name="Clinical content approved?" default="F_F3">
      <bpmn:incoming>F_F2</bpmn:incoming>
      <bpmn:outgoing>F_F3</bpmn:outgoing>
      <bpmn:outgoing>F_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_AdministrativeCheck" name="Perform the administrative checks and confirm the intended recipients">
      <bpmn:documentation>Administrative staff may correct formatting but must not change the clinical meaning.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-clinic-letter-admin-check" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="medical-secretaries" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_F4</bpmn:incoming>
      <bpmn:outgoing>F_F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_ClinicalError" name="Suspected clinical error in the letter?" default="F_F6">
      <bpmn:incoming>F_F7</bpmn:incoming>
      <bpmn:outgoing>F_F5</bpmn:outgoing>
      <bpmn:outgoing>F_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_CommunicationPreference" name="Does the patient require an accessible format, translation or a representative?" default="F_F6a">
      <bpmn:documentation>Case-study requirement: some patients prefer postal communication, some prefer digital communication, and others require accessible formats, translation support or assistance from an authorised representative.</bpmn:documentation>
      <bpmn:incoming>F_F6</bpmn:incoming>
      <bpmn:outgoing>F_F6a</bpmn:outgoing>
      <bpmn:outgoing>F_F6b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_PrepareAccessibleFormat" name="Produce the correspondence in the required accessible format or language">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-prepare-accessible-format" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="medical-secretaries" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_F6b</bpmn:incoming>
      <bpmn:outgoing>F_F6c</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T_DistributeClinicLetter" name="Distribute the clinic letter through the approved communication channels">
      <bpmn:extensionElements><zeebe:taskDefinition type="distribute-clinical-correspondence" /></bpmn:extensionElements>
      <bpmn:incoming>F_F6a</bpmn:incoming>
      <bpmn:incoming>F_F6c</bpmn:incoming>
      <bpmn:outgoing>F_G1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T_WeeklyReminder" name="Issue a weekly reminder to the responsible consultant">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-issue-letter-reminder" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="patient-pathway-coordinators" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_F8</bpmn:incoming>
      <bpmn:incoming>F_F10</bpmn:incoming>
      <bpmn:incoming>F_F11</bpmn:incoming>
      <bpmn:outgoing>F_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="T_ReminderInterval" name="Wait one week before the next reminder">
      <bpmn:incoming>F_F9</bpmn:incoming>
      <bpmn:outgoing>F_F10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="T_ReminderInterval_timerdef"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G_LetterAge" name="Letter outstanding for more than one month?" default="F_F9">
      <bpmn:incoming>F_F12</bpmn:incoming>
      <bpmn:outgoing>F_F9</bpmn:outgoing>
      <bpmn:outgoing>F_F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_EscalateToManager" name="Escalate to the Administrative Manager, who contacts the consultant">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-escalate-to-manager" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="administrative-management" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_F13</bpmn:incoming>
      <bpmn:outgoing>F_F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_LetterAgeExtended" name="Letter outstanding for more than three months?" default="F_F11">
      <bpmn:incoming>F_F14</bpmn:incoming>
      <bpmn:outgoing>F_F11</bpmn:outgoing>
      <bpmn:outgoing>F_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_EscalateToHigherManagement" name="Escalate to the higher management team">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-escalate-higher-management" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="administrative-management" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_F15</bpmn:incoming>
      <bpmn:outgoing>F_F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_DelayedCorrespondence" name="Delayed correspondence escalated">
      <bpmn:incoming>F_F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_RequestFollowUp" name="Request a follow-up appointment within the clinically specified period">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-request-follow-up" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_G1</bpmn:incoming>
      <bpmn:outgoing>F_G2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ArrangeFollowUp" name="Arrange the follow-up appointment using the External Scheduling Service">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-arrange-follow-up" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_G2</bpmn:incoming>
      <bpmn:outgoing>F_G3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_FollowUpWithinPeriod" name="Appointment found within the requested period?" default="F_G5">
      <bpmn:incoming>F_G3</bpmn:incoming>
      <bpmn:outgoing>F_G4</bpmn:outgoing>
      <bpmn:outgoing>F_G5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_HighlightFollowUp" name="Highlight the case and refer it to the relevant pathway team">
      <bpmn:documentation>A patient must never be silently booked outside the clinically requested period.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-highlight-follow-up" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="patient-pathway-coordinators" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_G5</bpmn:incoming>
      <bpmn:outgoing>F_G6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_FollowUpEscalated" name="Follow-up outside the clinical timescale escalated">
      <bpmn:incoming>F_G6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_ConfirmFollowUp" name="Confirm the follow-up appointment and notify the patient">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-confirm-follow-up" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_G4</bpmn:incoming>
      <bpmn:outgoing>F_G7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_NotAttending" name="Patient cancels, declines or does not attend" attachedToRef="T_ConfirmFollowUp">
      <bpmn:outgoing>F_G9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="B_NotAttending_msgdef" messageRef="Msg_PatientNotAttending" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="T_RecordNonAttendance" name="Record the cancellation or non-attendance and determine the next step">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-record-non-attendance" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_G9</bpmn:incoming>
      <bpmn:outgoing>F_G10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_PaymentOnAppointment" name="Does the cancelled appointment carry a payment?" default="F_G15">
      <bpmn:incoming>F_G10</bpmn:incoming>
      <bpmn:outgoing>F_G11</bpmn:outgoing>
      <bpmn:outgoing>F_G15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_RefundDecision" name="Determine whether the payment should be retained, transferred or refunded">
      <bpmn:documentation>Clinical staff may provide information but must not approve refunds without the required financial authority.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-refund-decision" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_G11</bpmn:incoming>
      <bpmn:outgoing>F_G12</bpmn:outgoing>
      <bpmn:outgoing>F_G16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_RequestRefund" name="Send the approved refund request to the External Payment Service Provider">
      <bpmn:extensionElements><zeebe:taskDefinition type="request-refund" /></bpmn:extensionElements>
      <bpmn:incoming>F_G12</bpmn:incoming>
      <bpmn:outgoing>F_G13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_RecordRefund" name="Record the refund result against the patient account">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-record-refund" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_G13</bpmn:incoming>
      <bpmn:outgoing>F_G14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_OfferAnotherAppointment" name="Offer a further appointment or refer the pathway for clinical review">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-offer-another-appointment" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_G14</bpmn:incoming>
      <bpmn:incoming>F_G15</bpmn:incoming>
      <bpmn:incoming>F_G16</bpmn:incoming>
      <bpmn:outgoing>F_G17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_PathwayReviewed" name="Appointment not attended: pathway reviewed">
      <bpmn:incoming>F_G17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_CompletePathway" name="Complete the pathway and discharge the patient">
      <bpmn:documentation>Decisions about continuing treatment, delaying treatment or discharging a patient remain clinical decisions.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-complete-pathway" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_G7</bpmn:incoming>
      <bpmn:outgoing>F_G8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_PathwayComplete" name="Patient pathway completed">
      <bpmn:incoming>F_G8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_D1" sourceRef="E_AuthorisedRequestReceived" targetRef="T_ValidateRequest">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D1m" sourceRef="E_TreatmentRequestManual" targetRef="T_ValidateRequest">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D2" sourceRef="T_ValidateRequest" targetRef="T_RequestTreatmentCapacity">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D3" sourceRef="T_RequestTreatmentCapacity" targetRef="G_CapacityConfirmed">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D4" name="Not confirmed" sourceRef="G_CapacityConfirmed" targetRef="T_KeepPending">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentCapacityConfirmed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D5" name="Confirmed" sourceRef="G_CapacityConfirmed" targetRef="T_DetermineFunding">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentCapacityConfirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D6" name="Retry without duplicate booking" sourceRef="T_KeepPending" targetRef="T_RequestTreatmentCapacity">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D7" sourceRef="T_DetermineFunding" targetRef="G_FundingApproved">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D8" name="Approval required" sourceRef="G_FundingApproved" targetRef="T_RequestFundingApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D9" name="Approved or not required" sourceRef="G_FundingApproved" targetRef="T_RecordFundingApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D10" name="Approval recorded" sourceRef="T_RequestFundingApproval" targetRef="T_DetermineFunding">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D11" sourceRef="T_RecordFundingApproval" targetRef="G_AdvancePaymentRequired">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D12" name="No advance payment" sourceRef="G_AdvancePaymentRequired" targetRef="T_ConfirmTreatmentSchedule">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D13" name="Advance payment required" sourceRef="G_AdvancePaymentRequired" targetRef="T_RequestSecurePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= advancePaymentRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D14" sourceRef="T_RequestSecurePayment" targetRef="G_PaymentOutcome">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D15" name="Payment confirmed" sourceRef="G_PaymentOutcome" targetRef="T_RecordPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = &quot;confirmed&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D16" name="Declined, cancelled or incomplete" sourceRef="G_PaymentOutcome" targetRef="T_HandlePaymentFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = &quot;declined&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D17" name="Further attempt authorised" sourceRef="T_HandlePaymentFailure" targetRef="T_RequestSecurePayment">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D18" name="Confirmation not returned" sourceRef="G_PaymentOutcome" targetRef="T_MarkForInvestigation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = &quot;no response&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D19" sourceRef="T_MarkForInvestigation" targetRef="T_ResolveTransaction">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D20" sourceRef="T_ResolveTransaction" targetRef="T_ConfirmTreatmentSchedule">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D21" name="Urgent clinical need" sourceRef="G_PaymentOutcome" targetRef="T_AuthoriseUrgentTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = &quot;urgent clinical need&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D22" name="Treatment proceeds" sourceRef="T_AuthoriseUrgentTreatment" targetRef="T_ConfirmTreatmentSchedule">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D23" name="Refer for financial resolution" sourceRef="T_AuthoriseUrgentTreatment" targetRef="T_ReferUnconfirmedPayment">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D24" sourceRef="T_ReferUnconfirmedPayment" targetRef="T_ConfirmTreatmentSchedule">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_D25" sourceRef="T_RecordPayment" targetRef="T_ConfirmTreatmentSchedule">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E1" sourceRef="T_ConfirmTreatmentSchedule" targetRef="T_DeliverTreatmentCycle">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E0" sourceRef="T_DeliverTreatmentCycle" targetRef="G_FurtherCycles">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E4b" sourceRef="T_ReviewCycleResults" targetRef="G_FitnessToContinue">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E2" name="No further cycles" sourceRef="G_FurtherCycles" targetRef="T_PrepareClinicLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= furtherCyclesPlanned = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E3" name="Further cycles planned" sourceRef="G_FurtherCycles" targetRef="T_RequestBloodTest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= furtherCyclesPlanned = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E4" sourceRef="T_RequestBloodTest" targetRef="T_ReviewCycleResults">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E5" name="Fit to continue" sourceRef="G_FitnessToContinue" targetRef="T_DeliverTreatmentCycle">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fitToContinue = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E6" name="Planned change required" sourceRef="G_FitnessToContinue" targetRef="T_ModifyTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fitToContinue = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E7" name="Immediate postponement required" sourceRef="G_FitnessToContinue" targetRef="T_UrgentPostponement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= urgentPostponement = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E8" name="Authorised retrospectively" sourceRef="T_UrgentPostponement" targetRef="T_ModifyTreatment">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E9" name="No financial impact" sourceRef="G_FinancialImpact" targetRef="T_ApplyTreatmentChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= financialImpact = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E10" name="Financial impact" sourceRef="G_FinancialImpact" targetRef="T_ReviewFinancialImpact">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= financialImpact = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E11" name="Funding record updated" sourceRef="T_ReviewFinancialImpact" targetRef="T_ApplyTreatmentChange">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E12" sourceRef="T_ModifyTreatment" targetRef="G_FinancialImpact">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_E13" name="Updated schedule" sourceRef="T_ApplyTreatmentChange" targetRef="T_DeliverTreatmentCycle">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F1" sourceRef="T_PrepareClinicLetter" targetRef="T_ApproveClinicLetter">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F2" sourceRef="T_ApproveClinicLetter" targetRef="G_LetterApproved">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F3" name="Not approved" sourceRef="G_LetterApproved" targetRef="T_PrepareClinicLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F4" name="Approved" sourceRef="G_LetterApproved" targetRef="T_AdministrativeCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F5" name="Returned to the Consultant" sourceRef="G_ClinicalError" targetRef="T_PrepareClinicLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suspectedClinicalError = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F6" name="No clinical error" sourceRef="G_ClinicalError" targetRef="G_CommunicationPreference">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suspectedClinicalError = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F6a" name="Standard format" sourceRef="G_CommunicationPreference" targetRef="T_DistributeClinicLetter">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F6b" name="Accessible format, translation or representative required" sourceRef="G_CommunicationPreference" targetRef="T_PrepareAccessibleFormat">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= accessibleFormatRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F6c" sourceRef="T_PrepareAccessibleFormat" targetRef="T_DistributeClinicLetter">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F7" sourceRef="T_AdministrativeCheck" targetRef="G_ClinicalError">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F8" name="Seven days elapsed" sourceRef="B_LetterDelayed" targetRef="T_WeeklyReminder">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F9" name="Less than one month" sourceRef="G_LetterAge" targetRef="T_ReminderInterval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterAgeMonths &lt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F10" sourceRef="T_ReminderInterval" targetRef="T_WeeklyReminder">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F11" name="Less than three months" sourceRef="G_LetterAgeExtended" targetRef="T_WeeklyReminder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterAgeMonths &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F12" sourceRef="T_WeeklyReminder" targetRef="G_LetterAge">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F13" name="More than one month" sourceRef="G_LetterAge" targetRef="T_EscalateToManager">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterAgeMonths &gt;= 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F14" sourceRef="T_EscalateToManager" targetRef="G_LetterAgeExtended">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F15" name="More than three months" sourceRef="G_LetterAgeExtended" targetRef="T_EscalateToHigherManagement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= letterAgeMonths &gt;= 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_F16" sourceRef="T_EscalateToHigherManagement" targetRef="E_DelayedCorrespondence">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G1" sourceRef="T_DistributeClinicLetter" targetRef="T_RequestFollowUp">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G2" sourceRef="T_RequestFollowUp" targetRef="T_ArrangeFollowUp">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G3" sourceRef="T_ArrangeFollowUp" targetRef="G_FollowUpWithinPeriod">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G4" name="Within period" sourceRef="G_FollowUpWithinPeriod" targetRef="T_ConfirmFollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= followUpSlotWithinPeriod = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G5" name="Not within period" sourceRef="G_FollowUpWithinPeriod" targetRef="T_HighlightFollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= followUpSlotWithinPeriod = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G6" sourceRef="T_HighlightFollowUp" targetRef="E_FollowUpEscalated">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G7" sourceRef="T_ConfirmFollowUp" targetRef="T_CompletePathway">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G8" sourceRef="T_CompletePathway" targetRef="E_PathwayComplete">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G9" sourceRef="B_NotAttending" targetRef="T_RecordNonAttendance">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G10" sourceRef="T_RecordNonAttendance" targetRef="G_PaymentOnAppointment">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G11" name="Payment involved" sourceRef="G_PaymentOnAppointment" targetRef="T_RefundDecision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentPaid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G12" name="Refund approved" sourceRef="T_RefundDecision" targetRef="T_RequestRefund">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G13" sourceRef="T_RequestRefund" targetRef="T_RecordRefund">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G14" sourceRef="T_RecordRefund" targetRef="T_OfferAnotherAppointment">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G15" name="No payment involved" sourceRef="G_PaymentOnAppointment" targetRef="T_OfferAnotherAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentPaid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G16" name="Payment retained or transferred" sourceRef="T_RefundDecision" targetRef="T_OfferAnotherAppointment">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_G17" sourceRef="T_OfferAnotherAppointment" targetRef="E_PathwayReviewed">
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="NOTE_S3_Level">
      <bpmn:text>ABSTRACTION LEVEL 2 - CROSS-FUNCTIONAL STRATEGIC COLLABORATION. Scope: treatment funding and payment, treatment delivery and review cycles, authorised treatment modification, clinical correspondence and pathway monitoring, follow-up and aftercare,
patient enquiry handling, and management reporting. Three processes are shown because they are genuinely independent: the patient pathway, enquiries (a patient may call at any time) and reporting (a monthly cycle, not a pathway step).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="NOTE_S3_Level_assoc" sourceRef="NOTE_S3_Level" targetRef="E_AuthorisedRequestReceived" associationDirection="None" />
    <bpmn:textAnnotation id="NOTE_S3_Link">
      <bpmn:text>LINK TO THE DETAILED OPERATIONAL MODEL. The funding and payment section decomposes into the operational model O1_Operational_Merged: T_DetermineFunding &gt; O1 T_DetermineFundingRoute; T_RecordFundingApproval &gt; O1 T_RecordFundingApproval;
T_RequestSecurePayment &gt; O1 T_SendSecurePaymentRequest (Zeebe job request-secure-payment, message flows MF_6 and MF_7); T_HandlePaymentFailure &gt; O1 T_HandlePaymentFailure; T_MarkForInvestigation &gt; O1 T_MarkForInvestigation; T_AuthoriseUrgentTreatment
&gt; O1 T_AuthoriseUrgentTreatment. Treatment delivery, cycle review, modification, correspondence, enquiries, follow-up, aftercare and reporting are modelled here but are NOT implemented in the initial release: those activities are the gap between the
wider business process and the built solution.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="NOTE_S3_Link_assoc" sourceRef="NOTE_S3_Link" targetRef="T_RequestSecurePayment" associationDirection="None" />
    <bpmn:textAnnotation id="NOTE_S3_Exceptions">
      <bpmn:text>EXCEPTION DESIGN REQUIRED BY THE CASE STUDY. An unavailable external service leaves the booking pending with a recorded retry and no duplicate appointment (G_CapacityConfirmed, T_KeepPending). A payment that is declined, cancelled or incomplete
allows a further attempt without creating a duplicate booking (T_HandlePaymentFailure). A payment taken by the provider whose confirmation was not returned is marked for investigation and is NEVER automatically re-requested (T_MarkForInvestigation).
Urgent treatment may proceed without confirmed payment where delay would create a patient risk, provided the reason is recorded and referred to the Finance Team (T_AuthoriseUrgentTreatment, T_ReferUnconfirmedPayment). Clinical staff may not approve
refunds without the required financial authority, and the Finance Team may not decide whether treatment is clinically necessary (T_RefundDecision).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="NOTE_S3_Exceptions_assoc" sourceRef="NOTE_S3_Exceptions" targetRef="G_PaymentOutcome" associationDirection="None" />
    <bpmn:textAnnotation id="NOTE_S3_Monitoring">
      <bpmn:text>PATHWAY MONITORING AND ESCALATION. A non-interrupting boundary timer starts pathway monitoring if a clinic letter is not approved within seven days, while the Consultant still owes the letter. The Patient Pathway Coordinators issue weekly reminders;
after one month the case is escalated to the Administrative Manager, who contacts the consultant; after three months it is escalated to the higher management team. Because the timer is non-interrupting and is cancelled when the letter is approved,
repeated reminders are not generated unnecessarily after a letter has been completed, and a full history of reminders, responses and escalations is retained.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="NOTE_S3_Monitoring_assoc" sourceRef="NOTE_S3_Monitoring" targetRef="B_LetterDelayed" associationDirection="None" />
  </bpmn:process>
  <bpmn:process id="PR_EnquiryHandling" name="Patient enquiry handling" isExecutable="true">
    <bpmn:laneSet id="PR_EnquiryHandling_laneSet">
      <bpmn:lane id="L_CHT" name="Call Handling Team">
        <bpmn:flowNodeRef>E_EnquiryReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_EnquiryManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ClassifyEnquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_EnquiryType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AnswerAdministrative</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordEnquiryOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_EnquiryClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CNS" name="Clinical Nurse Specialist Team">
        <bpmn:flowNodeRef>T_AnswerClinical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_HandleUrgentConcern</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_FIN_Q" name="Finance Team">
        <bpmn:flowNodeRef>T_AnswerFinancial</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E_EnquiryReceived" name="Patient or representative enquiry received">
      <bpmn:documentation>Enquiries are independent of a patient pathway instance, so they form a separate process.</bpmn:documentation>
      <bpmn:outgoing>F_Q1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E_EnquiryReceived_msgdef" messageRef="Msg_PatientEnquiry" />
    </bpmn:startEvent>
    <bpmn:startEvent id="E_EnquiryManual" name="Enquiry received (manual start)">
      <bpmn:documentation>The same enquiry, started by hand rather than by the incoming message, so the process can be run from the Operate or Tasklist user interface.</bpmn:documentation>
      <bpmn:outgoing>F_Q1m</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_ClassifyEnquiry" name="Record, classify and prioritise the enquiry">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-classify-enquiry" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="call-handling-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_Q1</bpmn:incoming>
      <bpmn:incoming>F_Q1m</bpmn:incoming>
      <bpmn:outgoing>F_Q2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_EnquiryType" name="What type of enquiry is it?" default="F_Q5">
      <bpmn:incoming>F_Q2</bpmn:incoming>
      <bpmn:outgoing>F_Q3</bpmn:outgoing>
      <bpmn:outgoing>F_Q4</bpmn:outgoing>
      <bpmn:outgoing>F_Q5</bpmn:outgoing>
      <bpmn:outgoing>F_Q6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_AnswerAdministrative" name="Answer or transfer the administrative enquiry to the responsible team">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-answer-administrative-enquiry" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="call-handling-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_Q3</bpmn:incoming>
      <bpmn:outgoing>F_Q7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_AnswerFinancial" name="Answer the payment or funding enquiry using authorised information">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-answer-financial-enquiry" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="finance-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_Q4</bpmn:incoming>
      <bpmn:outgoing>F_Q8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_AnswerClinical" name="Provide clinical advice through an authorised clinical professional">
      <bpmn:documentation>Call handlers must not diagnose, interpret results, recommend treatment or give clinical advice.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-answer-clinical-enquiry" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="clinical-nurse-specialist-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_Q5</bpmn:incoming>
      <bpmn:outgoing>F_Q9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_HandleUrgentConcern" name="Highlight and escalate the urgent clinical concern immediately">
      <bpmn:documentation>The hospital has not yet agreed a complete set of urgency rules; this is a documented open issue.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-urgent-clinical-concern" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="clinical-nurse-specialist-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_Q6</bpmn:incoming>
      <bpmn:outgoing>F_Q10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RecordEnquiryOutcome" name="Record the response, responsible team and resolution status">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-record-enquiry-outcome" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="call-handling-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_Q7</bpmn:incoming>
      <bpmn:incoming>F_Q8</bpmn:incoming>
      <bpmn:incoming>F_Q9</bpmn:incoming>
      <bpmn:incoming>F_Q10</bpmn:incoming>
      <bpmn:outgoing>F_Q11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_EnquiryClosed" name="Enquiry resolved and closed">
      <bpmn:incoming>F_Q11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Q1" sourceRef="E_EnquiryReceived" targetRef="T_ClassifyEnquiry">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Q1m" sourceRef="E_EnquiryManual" targetRef="T_ClassifyEnquiry">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Q2" sourceRef="T_ClassifyEnquiry" targetRef="G_EnquiryType">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Q3" name="Administrative" sourceRef="G_EnquiryType" targetRef="T_AnswerAdministrative">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryType = &quot;administrative&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Q4" name="Financial" sourceRef="G_EnquiryType" targetRef="T_AnswerFinancial">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryType = &quot;financial&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Q5" name="Clinical" sourceRef="G_EnquiryType" targetRef="T_AnswerClinical">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryType = &quot;clinical&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Q6" name="Urgent clinical concern" sourceRef="G_EnquiryType" targetRef="T_HandleUrgentConcern">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= enquiryType = &quot;urgent clinical&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Q7" sourceRef="T_AnswerAdministrative" targetRef="T_RecordEnquiryOutcome">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Q8" sourceRef="T_AnswerFinancial" targetRef="T_RecordEnquiryOutcome">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Q9" sourceRef="T_AnswerClinical" targetRef="T_RecordEnquiryOutcome">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Q10" sourceRef="T_HandleUrgentConcern" targetRef="T_RecordEnquiryOutcome">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Q11" sourceRef="T_RecordEnquiryOutcome" targetRef="E_EnquiryClosed">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="PR_ManagementReporting" name="Management reporting" isExecutable="true">
    <bpmn:laneSet id="PR_ManagementReporting_laneSet">
      <bpmn:lane id="L_MGT" name="Hospital Management">
        <bpmn:flowNodeRef>E_ReportingPeriodReached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ReportingManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_GenerateManagementReports</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReviewManagementReports</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ReportsPublished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E_ReportingPeriodReached" name="Monthly reporting period reached">
      <bpmn:documentation>Reporting is periodic and independent of any individual patient pathway, so it is a separate process with a timer start event.</bpmn:documentation>
      <bpmn:outgoing>F_R1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="E_ReportingPeriodReached_timerdef"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1M</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="E_ReportingManual" name="Report requested (manual start)">
      <bpmn:documentation>The same monthly report, started by hand so the reporting process can be run from the Operate or Tasklist user interface without waiting for the schedule. A management report is also a reasonable thing to re-run on demand.</bpmn:documentation>
      <bpmn:outgoing>F_R1m</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_GenerateManagementReports" name="Generate referral, waiting time, correspondence, funding, payment and pathway reports">
      <bpmn:documentation>Case-study requirement: management requires reports showing referral volumes, outstanding referrals, appointment waiting times, unsuccessful contact attempts, delayed clinic letters, unresolved enquiries, treatment-booking delays, outstanding funding approvals, failed or incomplete payments, refunds awaiting processing and the progress of individual patient pathways.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:taskDefinition type="generate-management-reports" /></bpmn:extensionElements>
      <bpmn:incoming>F_R1</bpmn:incoming>
      <bpmn:incoming>F_R1m</bpmn:incoming>
      <bpmn:outgoing>F_R2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_ReviewManagementReports" name="Review performance reports and agree corrective action">
      <bpmn:documentation>Management requires sufficient information to demonstrate accountability, identify delays and meet operational targets, while clinical staff are concerned that administrative recording could reduce the time available for patient care.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-review-management-reports" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="hospital-management" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_R2</bpmn:incoming>
      <bpmn:outgoing>F_R3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_ReportsPublished" name="Reports published and corrective action agreed">
      <bpmn:incoming>F_R3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_R1" sourceRef="E_ReportingPeriodReached" targetRef="T_GenerateManagementReports">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_R1m" sourceRef="E_ReportingManual" targetRef="T_GenerateManagementReports">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_R2" sourceRef="T_GenerateManagementReports" targetRef="T_ReviewManagementReports">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_R3" sourceRef="T_ReviewManagementReports" targetRef="E_ReportsPublished">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_S3">
      <bpmndi:BPMNShape id="P_Hospital_di" bpmnElement="P_Hospital" isHorizontal="true">
        <dc:Bounds x="697" y="80" width="8420" height="1747" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_TB_di" bpmnElement="L_TB" isHorizontal="true">
        <dc:Bounds x="727" y="80" width="8390" height="297" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_FIN_di" bpmnElement="L_FIN" isHorizontal="true">
        <dc:Bounds x="727" y="377" width="8390" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_CT_di" bpmnElement="L_CT" isHorizontal="true">
        <dc:Bounds x="727" y="627" width="8390" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_MS_di" bpmnElement="L_MS" isHorizontal="true">
        <dc:Bounds x="727" y="877" width="8390" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_OB_di" bpmnElement="L_OB" isHorizontal="true">
        <dc:Bounds x="727" y="1127" width="8390" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_PPC_di" bpmnElement="L_PPC" isHorizontal="true">
        <dc:Bounds x="727" y="1327" width="8390" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_AM_di" bpmnElement="L_AM" isHorizontal="true">
        <dc:Bounds x="727" y="1577" width="8390" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Enquiries_di" bpmnElement="P_Enquiries" isHorizontal="true">
        <dc:Bounds x="697" y="1897" width="8420" height="611" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_CHT_di" bpmnElement="L_CHT" isHorizontal="true">
        <dc:Bounds x="727" y="1897" width="8390" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_CNS_di" bpmnElement="L_CNS" isHorizontal="true">
        <dc:Bounds x="727" y="2147" width="8390" height="241" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_FIN_Q_di" bpmnElement="L_FIN_Q" isHorizontal="true">
        <dc:Bounds x="727" y="2388" width="8390" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Reporting_di" bpmnElement="P_Reporting" isHorizontal="true">
        <dc:Bounds x="697" y="2578" width="8420" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_MGT_di" bpmnElement="L_MGT" isHorizontal="true">
        <dc:Bounds x="727" y="2578" width="8390" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Patient_di" bpmnElement="P_Patient" isHorizontal="true">
        <dc:Bounds x="60" y="90" width="300" height="200" />
