{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Record, classify and prioritise the enquiry",
      "id": "Header_form-classify-enquiry",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "enquiryType",
      "label": "Enquiry type (administrative / financial / clinical / urgent clinical)",
      "type": "select",
      "values": [
        {
          "label": "Administrative",
          "value": "administrative"
        },
        {
          "label": "Financial",
          "value": "financial"
        },
        {
          "label": "Clinical",
          "value": "clinical"
        },
        {
          "label": "Urgent clinical",
          "value": "urgent clinical"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-classify-enquiry",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
