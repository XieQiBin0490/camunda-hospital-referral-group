{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Receive and validate the booking request",
      "id": "Header_form-validate-booking-request",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "referralUrgency",
      "label": "Referral urgency (urgent / routine)",
      "type": "select",
      "values": [
        {
          "label": "Urgent",
          "value": "urgent"
        },
        {
          "label": "Routine",
          "value": "routine"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-validate-booking-request",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
