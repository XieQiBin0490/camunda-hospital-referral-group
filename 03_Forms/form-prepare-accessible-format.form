{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Produce the correspondence in the required accessible format or language",
      "id": "Header_form-prepare-accessible-format",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    },
    {
      "type": "select",
      "key": "communicationPreference",
      "label": "Format or language actually produced",
      "values": [
        {
          "label": "Standard post",
          "value": "post"
        },
        {
          "label": "Email",
          "value": "email"
        },
        {
          "label": "Accessible format",
          "value": "accessible format"
        },
        {
          "label": "Translation",
          "value": "translation"
        },
        {
          "label": "Via a representative",
          "value": "representative"
        }
      ]
    }
  ],
  "type": "default",
  "id": "form-prepare-accessible-format",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
