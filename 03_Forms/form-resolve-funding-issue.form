{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Resolve the authorisation or funding issue",
      "id": "Header_form-resolve-funding-issue",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "fundingApproved",
      "label": "Funding approved or no payment required?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-resolve-funding-issue",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
