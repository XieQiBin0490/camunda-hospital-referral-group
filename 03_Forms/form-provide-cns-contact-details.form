{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Provide the patient with Clinical Nurse Specialist contact details",
      "id": "Header_form-provide-cns-contact-details",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "consentGiven",
      "label": "Patient consents to proceed with treatment?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-provide-cns-contact-details",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
