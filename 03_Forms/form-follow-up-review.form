{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Deliver follow-up care and clinical review",
      "id": "Header_form-follow-up-review",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "letterDelayDays",
      "label": "Delay in producing the letter, in days",
      "type": "number",
      "validate": {
        "max": 365,
        "min": 0,
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-follow-up-review",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
