<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_S2_ReferralToAuthorisation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Msg_Referral" name="Patient referral"></bpmn:message>
  <bpmn:message id="Msg_MissingDocumentation" name="Missing documentation request"></bpmn:message>
  <bpmn:message id="Msg_ReferralOutcome" name="Referral outcome notification"></bpmn:message>
  <bpmn:message id="Msg_ReferralRedirect" name="Referral redirect"></bpmn:message>
  <bpmn:message id="Msg_AppointmentSlotQuery" name="Appointment slot request"></bpmn:message>
  <bpmn:message id="Msg_AppointmentSlotResponse" name="Appointment slot response"></bpmn:message>
  <bpmn:message id="Msg_AppointmentConfirmationLetter" name="Appointment confirmation letter"></bpmn:message>
  <bpmn:message id="Msg_AppointmentContact" name="Telephone contact attempt"></bpmn:message>
  <bpmn:message id="Msg_AppointmentContactOutcome" name="Patient contact outcome"></bpmn:message>
  <bpmn:collaboration id="Collaboration_S2" name="S2 | Strategic collaboration: from referral to authorised treatment">
    <bpmn:participant id="P_Hospital" name="Specialist Hospital Service (Hospital Patient Administration System)" processRef="PR_ReferralToAuthorisation" />
    <bpmn:participant id="P_ReferringOrganisation" name="Referring Organisation (GP or another hospital)" />
    <bpmn:participant id="P_Patient" name="Patient / Authorised Representative" />
    <bpmn:participant id="P_Scheduling" name="External Scheduling Service" />
    <bpmn:participant id="P_Correspondence" name="External Correspondence Service" />
    <bpmn:participant id="P_OtherSpecialist" name="Other Specialist Service" />
    <bpmn:messageFlow id="MF_S1" name="Patient referral" sourceRef="P_ReferringOrganisation" targetRef="E_ReferralReceived" messageRef="Msg_Referral" />
    <bpmn:messageFlow id="MF_S2" name="Missing documentation request" sourceRef="T_RequestMissingDocs" targetRef="P_ReferringOrganisation" messageRef="Msg_MissingDocumentation" />
    <bpmn:messageFlow id="MF_S3" name="Referral outcome notification" sourceRef="T_NotifyNotAccepted" targetRef="P_ReferringOrganisation" messageRef="Msg_ReferralOutcome" />
    <bpmn:messageFlow id="MF_S4" name="Referral redirect" sourceRef="T_RedirectReferral" targetRef="P_OtherSpecialist" messageRef="Msg_ReferralRedirect" />
    <bpmn:messageFlow id="MF_S5" name="Appointment slot request" sourceRef="T_QuerySlots" targetRef="P_Scheduling" messageRef="Msg_AppointmentSlotQuery" />
    <bpmn:messageFlow id="MF_S6" name="Appointment slot response" sourceRef="P_Scheduling" targetRef="T_QuerySlots" messageRef="Msg_AppointmentSlotResponse" />
    <bpmn:messageFlow id="MF_S7" name="Appointment confirmation letter" sourceRef="T_SendAppointmentLetter" targetRef="P_Correspondence" messageRef="Msg_AppointmentConfirmationLetter" />
    <bpmn:messageFlow id="MF_S8" name="Telephone contact attempt" sourceRef="T_TelephonePatient" targetRef="P_Patient" messageRef="Msg_AppointmentContact" />
    <bpmn:messageFlow id="MF_S9" name="Patient contact outcome" sourceRef="P_Patient" targetRef="T_RecordContactOutcome" messageRef="Msg_AppointmentContactOutcome" />
  </bpmn:collaboration>
  <bpmn:process id="PR_ReferralToAuthorisation" name="Referral intake, appointment booking and treatment authorisation" isExecutable="true">
    <bpmn:laneSet id="PR_ReferralToAuthorisation_laneSet">
      <bpmn:lane id="L_MS" name="Medical Secretaries">
        <bpmn:flowNodeRef>E_ReferralReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ReferralReceivedManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegisterReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CheckDocumentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_documentsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestMissingDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_NotifyNotAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_NotAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RedirectReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Redirected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CT" name="Consultant / Clinical Team">
        <bpmn:flowNodeRef>T_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ReferralDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ForwardAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_NewPatientConsultation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PatientConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreateAuthorisedRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RequestAuthorised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_TreatmentAuthorised</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_OB" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>T_ReceiveBookingRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_UrgentReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ExpediteBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_QuerySlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SlotsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SelectBookAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ConfirmAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SendAppointmentLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_WithinFourteenDays</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PPC" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>T_ResolveCapacity</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CHT" name="Call Handling Team">
        <bpmn:flowNodeRef>T_TelephonePatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordContactOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ContactSuccessful</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_TB" name="Treatment &amp; Chemotherapy Bookings Team">
        <bpmn:flowNodeRef>T_ReturnUnauthorisedRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CNS" name="Clinical Nurse Specialist Team">
        <bpmn:flowNodeRef>T_ProvideCnsContactDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AdviseAndClose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Declined</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E_ReferralReceived" name="Patient referral received">
      <bpmn:documentation>Referral arrives from a General Practitioner or another hospital.</bpmn:documentation>
      <bpmn:outgoing>F_A1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E_ReferralReceived_msgdef" messageRef="Msg_Referral" />
    </bpmn:startEvent>
    <bpmn:startEvent id="E_ReferralReceivedManual" name="Referral received (manual start)">
      <bpmn:documentation>The same referral, started by hand rather than by the incoming message, so the process can be run from the Operate or Tasklist user interface.</bpmn:documentation>
      <bpmn:outgoing>F_A1m</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_RegisterReferral" name="Register the referral and confirm patient identification">
      <bpmn:documentation>Accurate patient identification reduces the risk of records being linked to the wrong patient.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-register-referral" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="medical-secretaries" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_A1</bpmn:incoming>
      <bpmn:incoming>F_A1m</bpmn:incoming>
      <bpmn:outgoing>F_A2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_CheckDocumentation" name="Check referral documentation completeness">
      <bpmn:documentation>Checks for previous clinic letters, investigation results and diagnostic reports.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-check-referral-documents" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="medical-secretaries" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_A2</bpmn:incoming>
      <bpmn:incoming>F_A6</bpmn:incoming>
      <bpmn:outgoing>F_A3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_documentsComplete" name="All expected supporting documents available?" default="F_A4">
      <bpmn:documentation>Medical Secretaries may request missing information but must not assess clinical suitability.</bpmn:documentation>
      <bpmn:incoming>F_A3</bpmn:incoming>
      <bpmn:outgoing>F_A4</bpmn:outgoing>
      <bpmn:outgoing>F_A5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_RequestMissingDocs" name="Request the missing documentation from the referring organisation">
      <bpmn:documentation>Records the outstanding documents and re-enters the completeness check when they arrive.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:taskDefinition type="request-missing-documentation" /></bpmn:extensionElements>
      <bpmn:incoming>F_A4</bpmn:incoming>
      <bpmn:incoming>F_A13</bpmn:incoming>
      <bpmn:outgoing>F_A6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T_ClinicalReview" name="Perform the clinical review of the referral">
      <bpmn:documentation>Only a Consultant may judge clinical suitability.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-clinical-review-referral" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_A5</bpmn:incoming>
      <bpmn:outgoing>F_A7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RecordDecision" name="Record the referral decision, rationale and responsible clinician">
      <bpmn:documentation>The reason for the decision and the identity of the decision maker must be recorded for audit.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-record-referral-decision" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_A7</bpmn:incoming>
      <bpmn:outgoing>F_A8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_ReferralDecision" name="Referral decision?" default="F_A9">
      <bpmn:documentation>Accept, reject, request further information or redirect to another specialist service.</bpmn:documentation>
      <bpmn:incoming>F_A8</bpmn:incoming>
      <bpmn:outgoing>F_A9</bpmn:outgoing>
      <bpmn:outgoing>F_A11</bpmn:outgoing>
      <bpmn:outgoing>F_A13</bpmn:outgoing>
      <bpmn:outgoing>F_A14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ForwardAccepted" name="Forward the accepted referral to the Outpatient Bookings Team">
      <bpmn:documentation>A New Patient Appointment may only be arranged after an authorised Consultant has accepted the referral.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-forward-accepted-referral" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_A14</bpmn:incoming>
      <bpmn:outgoing>F_B1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T_NotifyNotAccepted" name="Notify the referring organisation of the referral decision">
      <bpmn:documentation>Tells the referring organisation that the referral was not accepted, quoting the recorded reason.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:taskDefinition type="send-referral-outcome" /></bpmn:extensionElements>
      <bpmn:incoming>F_A9</bpmn:incoming>
      <bpmn:outgoing>F_A10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_NotAccepted" name="Referral closed: not accepted">
      <bpmn:incoming>F_A10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T_RedirectReferral" name="Redirect the referral to another specialist service">
      <bpmn:documentation>Used where the patient needs a different specialist service.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:taskDefinition type="redirect-referral" /></bpmn:extensionElements>
      <bpmn:incoming>F_A11</bpmn:incoming>
      <bpmn:outgoing>F_A12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_Redirected" name="Referral redirected">
      <bpmn:incoming>F_A12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_ReceiveBookingRequest" name="Receive and validate the new patient booking request">
      <bpmn:documentation>Booking request carries speciality, appointment priority, preferred timeframe and patient requirements.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-validate-booking-request" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_B1</bpmn:incoming>
      <bpmn:outgoing>F_B2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_UrgentReferral" name="Urgent referral requiring expedited booking?" default="F_B4">
      <bpmn:documentation>Urgent referrals cannot wait for normal administrative timescales.</bpmn:documentation>
      <bpmn:incoming>F_B2</bpmn:incoming>
      <bpmn:outgoing>F_B3</bpmn:outgoing>
      <bpmn:outgoing>F_B4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ExpediteBooking" name="Escalate the booking as urgent and agree the clinical timescale">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-expedite-urgent-booking" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_B3</bpmn:incoming>
      <bpmn:outgoing>F_B5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_QuerySlots" name="Request available appointment slots from the External Scheduling Service">
      <bpmn:documentation>Availability is held by an external scheduling service, not by the hospital system.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:taskDefinition type="query-available-appointment-slots" /></bpmn:extensionElements>
      <bpmn:incoming>F_B4</bpmn:incoming>
      <bpmn:incoming>F_B5</bpmn:incoming>
      <bpmn:incoming>F_B9</bpmn:incoming>
      <bpmn:outgoing>F_B6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_SlotsAvailable" name="Suitable appointment available within the requested period?" default="F_B8">
      <bpmn:incoming>F_B6</bpmn:incoming>
      <bpmn:outgoing>F_B7</bpmn:outgoing>
      <bpmn:outgoing>F_B8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ResolveCapacity" name="Highlight the case and resolve the capacity constraint">
      <bpmn:documentation>A patient must never be booked silently outside the period requested by the Consultant.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-resolve-capacity-constraint" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="patient-pathway-coordinators" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_B8</bpmn:incoming>
      <bpmn:outgoing>F_B9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_SelectBookAppointment" name="Select and book the new patient appointment">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-select-book-appointment" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_B7</bpmn:incoming>
      <bpmn:outgoing>F_B10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ConfirmAppointment" name="Confirm the appointment and record the booking reference">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-confirm-appointment" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_B10</bpmn:incoming>
      <bpmn:outgoing>F_B11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T_SendAppointmentLetter" name="Issue the appointment confirmation through the External Correspondence Service">
      <bpmn:extensionElements><zeebe:taskDefinition type="send-appointment-confirmation-letter" /></bpmn:extensionElements>
      <bpmn:incoming>F_B11</bpmn:incoming>
      <bpmn:outgoing>F_B12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="G_WithinFourteenDays" name="Appointment due within the next 14 days?" default="F_B13">
      <bpmn:documentation>If the appointment is within two weeks the patient must also be contacted by telephone.</bpmn:documentation>
      <bpmn:incoming>F_B12</bpmn:incoming>
      <bpmn:outgoing>F_B13</bpmn:outgoing>
      <bpmn:outgoing>F_B14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_TelephonePatient" name="Telephone the patient to confirm attendance">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-telephone-patient" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="call-handling-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_B14</bpmn:incoming>
      <bpmn:incoming>F_B17</bpmn:incoming>
      <bpmn:outgoing>F_B15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RecordContactOutcome" name="Record the contact attempt and its outcome">
      <bpmn:documentation>A call may be unanswered, the number may be wrong, or the patient may request another appointment.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-record-contact-outcome" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="call-handling-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_B15</bpmn:incoming>
      <bpmn:outgoing>F_B16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_ContactSuccessful" name="Patient confirmed the appointment?" default="F_B17">
      <bpmn:incoming>F_B16</bpmn:incoming>
      <bpmn:outgoing>F_B17</bpmn:outgoing>
      <bpmn:outgoing>F_B18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_NewPatientConsultation" name="Deliver the new patient consultation and discuss treatment options">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-new-patient-consultation" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_B13</bpmn:incoming>
      <bpmn:incoming>F_B18</bpmn:incoming>
      <bpmn:outgoing>F_C1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ProvideCnsContactDetails" name="Provide the patient with Clinical Nurse Specialist contact details">
      <bpmn:documentation>Following the New Patient Appointment the patient receives information about the Clinical Nurse Specialist Team and an appropriate contact number.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-provide-cns-contact-details" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="clinical-nurse-specialist-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_C1</bpmn:incoming>
      <bpmn:outgoing>F_C1b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_PatientConsent" name="Patient consents to proceed with treatment?" default="F_C3">
      <bpmn:incoming>F_C1b</bpmn:incoming>
      <bpmn:outgoing>F_C2</bpmn:outgoing>
      <bpmn:outgoing>F_C3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_AdviseAndClose" name="Provide clinical advice and record the decision not to proceed">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-advise-no-treatment" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="clinical-nurse-specialist-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_C3</bpmn:incoming>
      <bpmn:outgoing>F_C4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_Declined" name="Pathway closed: treatment declined">
      <bpmn:incoming>F_C4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_RecordConsent" name="Record the patient consent to treatment">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-record-patient-consent" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_C2</bpmn:incoming>
      <bpmn:outgoing>F_C5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_CreateAuthorisedRequest" name="Create the authorised Treatment Booking Request">
      <bpmn:documentation>Records the proposed treatment, start date, number and frequency of cycles, reviews between cycles and special resources.</bpmn:documentation>
      <bpmn:extensionElements><zeebe:formDefinition formId="form-treatment-booking-request" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="consultant-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_C5</bpmn:incoming>
      <bpmn:incoming>F_C9</bpmn:incoming>
      <bpmn:outgoing>F_C6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_RequestAuthorised" name="Request completed and authorised by an authorised clinical professional?" default="F_C7">
      <bpmn:documentation>A request that has not been completed and authorised must not be processed by administrative staff.</bpmn:documentation>
      <bpmn:incoming>F_C6</bpmn:incoming>
      <bpmn:outgoing>F_C7</bpmn:outgoing>
      <bpmn:outgoing>F_C8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ReturnUnauthorisedRequest" name="Return the unauthorised request to the clinical team">
      <bpmn:extensionElements><zeebe:formDefinition formId="form-return-unauthorised-request" binding="deployment" /><zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" /><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>F_C7</bpmn:incoming>
      <bpmn:outgoing>F_C9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_TreatmentAuthorised" name="Treatment booking request authorised">
      <bpmn:incoming>F_C8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_A1" sourceRef="E_ReferralReceived" targetRef="T_RegisterReferral">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A1m" sourceRef="E_ReferralReceivedManual" targetRef="T_RegisterReferral">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A2" sourceRef="T_RegisterReferral" targetRef="T_CheckDocumentation">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A3" sourceRef="T_CheckDocumentation" targetRef="G_documentsComplete">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A4" name="Documents missing" sourceRef="G_documentsComplete" targetRef="T_RequestMissingDocs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A5" name="Documents complete" sourceRef="G_documentsComplete" targetRef="T_ClinicalReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A6" name="Documents received" sourceRef="T_RequestMissingDocs" targetRef="T_CheckDocumentation">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A7" sourceRef="T_ClinicalReview" targetRef="T_RecordDecision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A8" sourceRef="T_RecordDecision" targetRef="G_ReferralDecision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A9" name="Rejected" sourceRef="G_ReferralDecision" targetRef="T_NotifyNotAccepted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = &quot;rejected&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A10" sourceRef="T_NotifyNotAccepted" targetRef="E_NotAccepted">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A11" name="Redirected" sourceRef="G_ReferralDecision" targetRef="T_RedirectReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = &quot;redirected&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A12" sourceRef="T_RedirectReferral" targetRef="E_Redirected">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A13" name="Further information required" sourceRef="G_ReferralDecision" targetRef="T_RequestMissingDocs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = &quot;information required&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_A14" name="Accepted" sourceRef="G_ReferralDecision" targetRef="T_ForwardAccepted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = &quot;accepted&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B1" sourceRef="T_ForwardAccepted" targetRef="T_ReceiveBookingRequest">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B2" sourceRef="T_ReceiveBookingRequest" targetRef="G_UrgentReferral">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B3" name="Urgent" sourceRef="G_UrgentReferral" targetRef="T_ExpediteBooking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralUrgency = &quot;urgent&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B4" name="Routine" sourceRef="G_UrgentReferral" targetRef="T_QuerySlots">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralUrgency = &quot;routine&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B5" sourceRef="T_ExpediteBooking" targetRef="T_QuerySlots">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B6" sourceRef="T_QuerySlots" targetRef="G_SlotsAvailable">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B7" name="Appointment available" sourceRef="G_SlotsAvailable" targetRef="T_SelectBookAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suitableSlotFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B8" name="No suitable appointment" sourceRef="G_SlotsAvailable" targetRef="T_ResolveCapacity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suitableSlotFound = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B9" name="Capacity reviewed" sourceRef="T_ResolveCapacity" targetRef="T_QuerySlots">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B10" sourceRef="T_SelectBookAppointment" targetRef="T_ConfirmAppointment">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B11" sourceRef="T_ConfirmAppointment" targetRef="T_SendAppointmentLetter">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B12" sourceRef="T_SendAppointmentLetter" targetRef="G_WithinFourteenDays">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B13" name="More than 14 days away" sourceRef="G_WithinFourteenDays" targetRef="T_NewPatientConsultation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentWithin14Days = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B14" name="Within 14 days" sourceRef="G_WithinFourteenDays" targetRef="T_TelephonePatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentWithin14Days = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B15" sourceRef="T_TelephonePatient" targetRef="T_RecordContactOutcome">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B16" sourceRef="T_RecordContactOutcome" targetRef="G_ContactSuccessful">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B17" name="No answer, wrong number or alternative requested" sourceRef="G_ContactSuccessful" targetRef="T_TelephonePatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactSuccessful = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_B18" name="Attendance confirmed" sourceRef="G_ContactSuccessful" targetRef="T_NewPatientConsultation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactSuccessful = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_C1" sourceRef="T_NewPatientConsultation" targetRef="T_ProvideCnsContactDetails">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_C1b" sourceRef="T_ProvideCnsContactDetails" targetRef="G_PatientConsent">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_C2" name="Consent given" sourceRef="G_PatientConsent" targetRef="T_RecordConsent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_C3" name="Consent refused" sourceRef="G_PatientConsent" targetRef="T_AdviseAndClose">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_C4" sourceRef="T_AdviseAndClose" targetRef="E_Declined">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_C5" sourceRef="T_RecordConsent" targetRef="T_CreateAuthorisedRequest">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_C6" sourceRef="T_CreateAuthorisedRequest" targetRef="G_RequestAuthorised">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_C7" name="Not authorised" sourceRef="G_RequestAuthorised" targetRef="T_ReturnUnauthorisedRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestAuthorised = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_C8" name="Authorised" sourceRef="G_RequestAuthorised" targetRef="E_TreatmentAuthorised">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestAuthorised = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_C9" name="Request corrected and resubmitted" sourceRef="T_ReturnUnauthorisedRequest" targetRef="T_CreateAuthorisedRequest">
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="NOTE_S2_Level">
      <bpmn:text>ABSTRACTION LEVEL 2 - CROSS-FUNCTIONAL STRATEGIC COLLABORATION. Scope: referral intake and triage, new patient appointment booking, consultation and consent, and clinical authorisation of treatment. Activities are business activities, not keystrokes:
each is attributed to the organisational unit accountable for it, and each carries a documentation element naming the operational sub-process it decomposes into. Only lanes that carry work in this scope are declared.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="NOTE_S2_Level_assoc" sourceRef="NOTE_S2_Level" targetRef="E_ReferralReceived" associationDirection="None" />
    <bpmn:textAnnotation id="NOTE_S2_Link">
      <bpmn:text>LINK TO THE DETAILED OPERATIONAL MODEL. The operational model O1_Operational_Merged implements this process at task level. Examples of the mapping: T_CheckDocumentation &gt; O1 T_CheckReferralDocuments; T_RequestMissingDocs &gt; O1
T_RequestMissingDocuments (Zeebe job request-missing-documentation, message flow MF_S2); T_QuerySlots &gt; O1 T_QueryAvailableSlots (job query-available-appointment-slots); T_TelephonePatient &gt; O1 T_TelephonePatient (conditional on
appointmentWithin14Days); T_CreateAuthorisedRequest &gt; O1 T_CreateTreatmentBookingRequest. An activity with no operational counterpart is a gap, not an implementation.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="NOTE_S2_Link_assoc" sourceRef="NOTE_S2_Link" targetRef="T_QuerySlots" associationDirection="None" />
    <bpmn:textAnnotation id="NOTE_S2_Rules">
      <bpmn:text>BUSINESS RULES MODELLED AS GATEWAYS AND CONSTRAINTS. Only an authorised Consultant may judge clinical suitability or accept a referral, and the reason and decision maker must be recorded (T_RecordDecision). A New Patient Appointment may only be
arranged after an authorised acceptance (G_RequestAuthorised and F_A14). The patient must also be telephoned when the appointment is due within 14 days (G_WithinFourteenDays). An appointment is never booked silently outside the period requested by
the Consultant (T_ResolveCapacity). A Treatment Booking Request that is incomplete or unauthorised must not be processed by administrative staff (G_RequestAuthorised).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="NOTE_S2_Rules_assoc" sourceRef="NOTE_S2_Rules" targetRef="G_ReferralDecision" associationDirection="None" />
  </bpmn:process>
