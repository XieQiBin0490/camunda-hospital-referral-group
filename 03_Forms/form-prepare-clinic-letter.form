{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Prepare the clinic letter",
      "id": "Header_form-prepare-clinic-letter",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "letterApproved",
      "label": "Clinical content of the letter approved?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-prepare-clinic-letter",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
