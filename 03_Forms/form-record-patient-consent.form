{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Record the patient consent to treatment",
      "id": "Header_form-record-patient-consent",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "requestAuthorised",
      "label": "Request completed and authorised by a clinical professional?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-record-patient-consent",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
