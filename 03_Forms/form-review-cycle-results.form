{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Review the results and confirm whether the patient is fit to continue",
      "id": "Header_form-review-cycle-results",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "fitToContinue",
      "label": "Patient fit to continue as planned?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "urgentPostponement",
      "label": "Immediate postponement required for patient safety?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-review-cycle-results",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
