{
  "components": [
    {
      "text": "# Record the referral decision, rationale and responsible clinician",
      "type": "text",
      "id": "Header_form-record-referral-decision",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "label": "Referral decision (accepted / rejected / information required / redirected)",
      "key": "referralDecision",
      "type": "select",
      "id": "Field_1s1dwkj",
      "values": [
        {
          "label": "Accepted",
          "value": "accepted"
        },
        {
          "label": "Rejected",
          "value": "rejected"
        },
        {
          "label": "Information required",
          "value": "information required"
        },
        {
          "label": "Redirected",
          "value": "redirected"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Destination service (only when the referral is redirected)",
      "key": "redirectDestination",
      "type": "textfield",
      "id": "Field_032b4l2"
    },
    {
      "label": "Patient identifier",
      "key": "patientId",
      "type": "textfield",
      "id": "Field_1u3bw0v",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "schemaVersion": 19,
  "type": "default",
