<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_O1_Operational" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Msg_Referral" name="Patient referral" />
  <bpmn:message id="Msg_MissingDocumentation" name="Missing documentation request" />
  <bpmn:message id="Msg_ReferralOutcome" name="Referral outcome notification">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= referralReference" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_ReferralRedirect" name="Referral redirect" />
  <bpmn:message id="Msg_AppointmentSlotQuery" name="Appointment slot request" />
  <bpmn:message id="Msg_AppointmentSlotResponse" name="Appointment slot response" />
  <bpmn:message id="Msg_AppointmentConfirmationLetter" name="Appointment confirmation letter" />
  <bpmn:message id="Msg_AppointmentContact" name="Telephone contact attempt" />
  <bpmn:message id="Msg_AppointmentContactOutcome" name="Patient contact outcome" />
  <bpmn:message id="Msg_TreatmentCapacityRequest" name="Treatment capacity request" />
  <bpmn:message id="Msg_TreatmentCapacityResponse" name="Treatment capacity response" />
  <bpmn:message id="Msg_FundingApprovalRequest" name="Funding approval request" />
  <bpmn:message id="Msg_FundingApprovalResponse" name="Funding approval response" />
  <bpmn:message id="Msg_SecurePaymentRequest" name="Secure payment request" />
  <bpmn:message id="Msg_PaymentStatus" name="Payment status" />
  <bpmn:collaboration id="Collaboration_O1" name="O1 | Operational model: merged patient referral, appointment and treatment payment process">
    <bpmn:participant id="P_Hospital" name="Specialist Hospital Service (Hospital Patient Administration System)" processRef="PR_Operational_Merged" />
    <bpmn:participant id="P_ReferringOrganisation" name="Referring Organisation (GP or another hospital)" processRef="PR_ReferringOrganisation" />
    <bpmn:participant id="P_Patient" name="Patient / Authorised Representative" />
    <bpmn:participant id="P_Scheduling" name="External Scheduling Service" />
    <bpmn:participant id="P_Correspondence" name="External Correspondence Service" />
    <bpmn:participant id="P_OtherSpecialist" name="Other Specialist Service" />
    <bpmn:participant id="P_ClinicalServices" name="External Clinical Services (treatment, laboratory, imaging)" />
    <bpmn:participant id="P_FundingOrganisation" name="Funding Organisation / Insurer" />
    <bpmn:participant id="P_PaymentProvider" name="External Payment Service Provider" />
    <bpmn:messageFlow id="MF_01" name="Patient referral" sourceRef="P_ReferringOrganisation" targetRef="E_ReferralReceived" messageRef="Msg_Referral" />
    <bpmn:messageFlow id="MF_02" name="Missing documentation request" sourceRef="T_RequestMissingDocuments" targetRef="P_ReferringOrganisation" messageRef="Msg_MissingDocumentation" />
    <bpmn:messageFlow id="MF_03" name="Referral outcome notification" sourceRef="T_NotifyReferralOutcome" targetRef="P_ReferringOrganisation" messageRef="Msg_ReferralOutcome" />
    <bpmn:messageFlow id="MF_04" name="Referral redirect" sourceRef="T_RedirectReferral" targetRef="P_OtherSpecialist" messageRef="Msg_ReferralRedirect" />
    <bpmn:messageFlow id="MF_05" name="Appointment slot request" sourceRef="T_QueryAvailableSlots" targetRef="P_Scheduling" messageRef="Msg_AppointmentSlotQuery" />
    <bpmn:messageFlow id="MF_06" name="Appointment slot response" sourceRef="P_Scheduling" targetRef="T_QueryAvailableSlots" messageRef="Msg_AppointmentSlotResponse" />
    <bpmn:messageFlow id="MF_07" name="Appointment confirmation letter" sourceRef="T_SendAppointmentLetter" targetRef="P_Correspondence" messageRef="Msg_AppointmentConfirmationLetter" />
    <bpmn:messageFlow id="MF_08" name="Telephone contact attempt" sourceRef="T_TelephonePatient" targetRef="P_Patient" messageRef="Msg_AppointmentContact" />
    <bpmn:messageFlow id="MF_09" name="Patient contact outcome" sourceRef="P_Patient" targetRef="T_RecordContactAttempt" messageRef="Msg_AppointmentContactOutcome" />
    <bpmn:messageFlow id="MF_10" name="Treatment capacity request" sourceRef="T_RequestTreatmentCapacity" targetRef="P_ClinicalServices" messageRef="Msg_TreatmentCapacityRequest" />
    <bpmn:messageFlow id="MF_11" name="Treatment capacity response" sourceRef="P_ClinicalServices" targetRef="T_RequestTreatmentCapacity" messageRef="Msg_TreatmentCapacityResponse" />
    <bpmn:messageFlow id="MF_12" name="Funding approval request" sourceRef="T_RequestFundingApproval" targetRef="P_FundingOrganisation" messageRef="Msg_FundingApprovalRequest" />
    <bpmn:messageFlow id="MF_13" name="Funding approval response" sourceRef="P_FundingOrganisation" targetRef="T_RequestFundingApproval" messageRef="Msg_FundingApprovalResponse" />
    <bpmn:messageFlow id="MF_14" name="Secure payment request" sourceRef="T_SendSecurePaymentRequest" targetRef="P_PaymentProvider" messageRef="Msg_SecurePaymentRequest" />
    <bpmn:messageFlow id="MF_15" name="Payment status" sourceRef="P_PaymentProvider" targetRef="T_SendSecurePaymentRequest" messageRef="Msg_PaymentStatus" />
  </bpmn:collaboration>
  <bpmn:process id="PR_Operational_Merged" name="Referral, appointment, treatment authorisation and payment" isExecutable="true">
    <bpmn:laneSet id="PR_Operational_Merged_laneSet">
      <bpmn:lane id="L_MS" name="Medical Secretaries">
        <bpmn:flowNodeRef>E_ReferralReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ReferralReceivedManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReceiveReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CheckReferralDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_DocumentsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestMissingDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ReferralClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RedirectReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ReferralRedirected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_NotifyReferralOutcome</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CT" name="Consultant / Clinical Team">
        <bpmn:flowNodeRef>T_ClinicalReviewReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordReferralDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ReferralDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ForwardAcceptedReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_NewPatientConsultation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PatientConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordPatientConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CreateTreatmentBookingRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RequestAuthorised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AuthoriseUrgentTreatment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_OB" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>T_ReceiveBookingRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_UrgentReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ExpediteUrgentBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_QueryAvailableSlots</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SlotsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SelectAndBookSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ConfirmBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SendAppointmentLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_WithinFourteenDays</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CHT" name="Call Handling Team">
        <bpmn:flowNodeRef>T_TelephonePatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordContactAttempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ContactSuccessful</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_TB" name="Treatment &#38; Chemotherapy Bookings Team">
        <bpmn:flowNodeRef>T_ReturnUnauthorisedRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ValidateTreatmentRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestTreatmentCapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CapacityConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_KeepPending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ConfirmTreatmentSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_TreatmentScheduled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_FIN" name="Finance Team">
        <bpmn:flowNodeRef>T_DetermineFundingRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_FundingApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordFundingApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestFundingApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_AdvancePaymentRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_SendSecurePaymentRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PaymentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecordPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_HandlePaymentFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_MarkForInvestigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ResolveTransaction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReferUnconfirmedPayment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_CNS" name="Clinical Nurse Specialist Team">
        <bpmn:flowNodeRef>T_AdviseNoTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_TreatmentDeclined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PPC" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>T_ResolveCapacity</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E_ReferralReceived" name="Patient referral received">
      <bpmn:documentation>Referral arrives from a General Practitioner or another hospital.</bpmn:documentation>
      <bpmn:outgoing>F_1_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E_ReferralReceived_msgdef" messageRef="Msg_Referral" />
    </bpmn:startEvent>
    <bpmn:startEvent id="E_ReferralReceivedManual" name="Referral received (manual start)">
      <bpmn:documentation>The same referral, started by hand rather than by the incoming message. Kept so that the process can be run and demonstrated from the Operate and Tasklist user interfaces, which can only start a process that has a plain start event; the message start above remains the production route.</bpmn:documentation>
      <bpmn:outgoing>F_1_1m</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_ReceiveReferral" name="Receive and register the referral">
      <bpmn:documentation>Registers the referral and confirms patient identification so that records are not associated with the wrong patient.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-receive-referral" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_1_1</bpmn:incoming>
      <bpmn:incoming>F_1_1m</bpmn:incoming>
      <bpmn:outgoing>F_1_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_CheckReferralDocuments" name="Check referral documentation completeness">
      <bpmn:documentation>Checks for previous clinic letters, investigation results, diagnostic reports and other relevant clinical documentation.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-check-referral-documents" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="medical-secretaries" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_1_2</bpmn:incoming>
      <bpmn:incoming>F_1_6</bpmn:incoming>
      <bpmn:outgoing>F_1_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_DocumentsComplete" name="All expected supporting documents available?" default="F_1_4">
      <bpmn:documentation>Business rule: Medical Secretaries may request missing information but must not assess clinical suitability.</bpmn:documentation>
      <bpmn:incoming>F_1_3</bpmn:incoming>
      <bpmn:outgoing>F_1_4</bpmn:outgoing>
      <bpmn:outgoing>F_1_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_RequestMissingDocuments" name="Request missing documentation from the referring organisation">
      <bpmn:documentation>Records the outstanding documents and returns the referral to the completeness check when they arrive.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-missing-documentation" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_1_4</bpmn:incoming>
      <bpmn:incoming>F_1_13</bpmn:incoming>
      <bpmn:outgoing>F_1_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T_ClinicalReviewReferral" name="Perform the clinical review of the referral">
      <bpmn:documentation>Business rule: only an authorised Consultant may judge clinical suitability or decide whether the referral is accepted.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-clinical-review-referral" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="consultant-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_1_5</bpmn:incoming>
      <bpmn:outgoing>F_1_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RecordReferralDecision" name="Record the referral decision, rationale and responsible clinician">
      <bpmn:documentation>The reason for the decision and the identity of the person making it must be recorded.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-record-referral-decision" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="consultant-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_1_7</bpmn:incoming>
      <bpmn:outgoing>F_1_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_ReferralDecision" name="Referral decision?" default="F_1_9">
      <bpmn:documentation>The Consultant may accept the referral, reject it, request further information or redirect it to another specialist service.</bpmn:documentation>
      <bpmn:incoming>F_1_8</bpmn:incoming>
      <bpmn:outgoing>F_1_9</bpmn:outgoing>
      <bpmn:outgoing>F_1_11</bpmn:outgoing>
      <bpmn:outgoing>F_1_13</bpmn:outgoing>
      <bpmn:outgoing>F_1_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ForwardAcceptedReferral" name="Forward the accepted referral to the Outpatient Bookings Team">
      <bpmn:documentation>Business rule: a New Patient Appointment may only be arranged after an authorised Consultant has accepted the referral.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-forward-accepted-referral" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="consultant-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_1_14</bpmn:incoming>
      <bpmn:outgoing>F_2_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_ReferralClosed" name="Referral closed: not accepted">
      <bpmn:incoming>F_1_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T_RedirectReferral" name="Redirect the referral to another specialist service">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="redirect-referral" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_1_11</bpmn:incoming>
      <bpmn:outgoing>F_1_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_ReferralRedirected" name="Referral redirected">
      <bpmn:incoming>F_1_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_ReceiveBookingRequest" name="Receive and validate the booking request">
      <bpmn:documentation>The booking request carries the required speciality, appointment priority, preferred timeframe and any relevant patient requirements.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-validate-booking-request" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_2_1</bpmn:incoming>
      <bpmn:outgoing>F_2_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_UrgentReferral" name="Urgent referral requiring expedited booking?" default="F_2_3">
      <bpmn:documentation>Business rule: urgent referrals cannot wait for normal administrative timescales.</bpmn:documentation>
      <bpmn:incoming>F_2_2</bpmn:incoming>
      <bpmn:outgoing>F_2_3</bpmn:outgoing>
      <bpmn:outgoing>F_2_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ExpediteUrgentBooking" name="Escalate the booking as urgent and agree the clinical timescale">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-expedite-urgent-booking" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_2_3</bpmn:incoming>
      <bpmn:outgoing>F_2_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_QueryAvailableSlots" name="Request available appointment slots from the external scheduling service">
      <bpmn:documentation>Availability is held by an external scheduling service; the hospital system cannot create capacity.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="query-available-appointment-slots" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_2_4</bpmn:incoming>
      <bpmn:incoming>F_2_5</bpmn:incoming>
      <bpmn:incoming>F_2_7</bpmn:incoming>
      <bpmn:outgoing>F_2_5a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_SlotsAvailable" name="Suitable appointment available within the requested period?" default="F_2_6">
      <bpmn:incoming>F_2_5a</bpmn:incoming>
      <bpmn:outgoing>F_2_6</bpmn:outgoing>
      <bpmn:outgoing>F_2_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ResolveCapacity" name="Highlight the case and resolve the capacity constraint">
      <bpmn:documentation>Exception path: where no suitable appointment exists, the patient must not be booked silently outside the period requested by the Consultant.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-resolve-capacity-constraint" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="patient-pathway-coordinators" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_2_6</bpmn:incoming>
      <bpmn:outgoing>F_2_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_SelectAndBookSlot" name="Select and book the new patient appointment">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-select-book-appointment" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_2_8</bpmn:incoming>
      <bpmn:outgoing>F_2_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ConfirmBooking" name="Confirm the booking and record the appointment reference">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-confirm-appointment" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="outpatient-bookings-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_2_9</bpmn:incoming>
      <bpmn:outgoing>F_2_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T_SendAppointmentLetter" name="Issue the appointment confirmation letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-appointment-confirmation-letter" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_2_10</bpmn:incoming>
      <bpmn:outgoing>F_2_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="G_WithinFourteenDays" name="Appointment due within the next 14 days?" default="F_2_12">
      <bpmn:documentation>Business rule: if the appointment is due to take place within the following two weeks the patient must also be contacted by telephone.</bpmn:documentation>
      <bpmn:incoming>F_2_11</bpmn:incoming>
      <bpmn:outgoing>F_2_12</bpmn:outgoing>
      <bpmn:outgoing>F_2_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_TelephonePatient" name="Telephone the patient to confirm attendance">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-telephone-patient" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="call-handling-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_2_13</bpmn:incoming>
      <bpmn:incoming>F_2_16</bpmn:incoming>
      <bpmn:outgoing>F_2_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RecordContactAttempt" name="Record the contact attempt and its outcome">
      <bpmn:documentation>Business rule: a telephone call may be unanswered, the contact number may be incorrect, or the patient may request an alternative appointment. Each attempt and its outcome must be recorded.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-record-contact-outcome" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="call-handling-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_2_14</bpmn:incoming>
      <bpmn:outgoing>F_2_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_ContactSuccessful" name="Patient confirmed the appointment?" default="F_2_16">
      <bpmn:incoming>F_2_15</bpmn:incoming>
      <bpmn:outgoing>F_2_16</bpmn:outgoing>
      <bpmn:outgoing>F_2_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_NewPatientConsultation" name="Deliver the new patient consultation and discuss treatment options">
      <bpmn:documentation>The Consultant and the relevant clinical team assess the patient, discuss the diagnosis and explain the available treatment options.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-new-patient-consultation" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="consultant-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_2_12</bpmn:incoming>
      <bpmn:incoming>F_2_17</bpmn:incoming>
      <bpmn:outgoing>F_3_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_PatientConsent" name="Patient consents to proceed with treatment?" default="F_3_3">
      <bpmn:incoming>F_3_1</bpmn:incoming>
      <bpmn:outgoing>F_3_2</bpmn:outgoing>
      <bpmn:outgoing>F_3_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_AdviseNoTreatment" name="Provide clinical advice and record the decision not to proceed">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-advise-no-treatment" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="clinical-nurse-specialist-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_3</bpmn:incoming>
      <bpmn:outgoing>F_3_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_TreatmentDeclined" name="Pathway closed: treatment declined">
      <bpmn:incoming>F_3_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_RecordPatientConsent" name="Record the patient consent to treatment">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-record-patient-consent" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="consultant-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_2</bpmn:incoming>
      <bpmn:outgoing>F_3_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_CreateTreatmentBookingRequest" name="Create the authorised Treatment Booking Request">
      <bpmn:documentation>Identifies the proposed treatment, the required start date, the number and frequency of treatment cycles, any reviews required between cycles and any special resources needed.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-treatment-booking-request" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="consultant-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_5</bpmn:incoming>
      <bpmn:incoming>F_3_8</bpmn:incoming>
      <bpmn:outgoing>F_3_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_RequestAuthorised" name="Request completed and authorised by an authorised clinical professional?" default="F_3_7">
      <bpmn:documentation>Business rule: a request that has not been completed and authorised by an appropriate clinical professional must not be processed by administrative staff.</bpmn:documentation>
      <bpmn:incoming>F_3_6</bpmn:incoming>
      <bpmn:outgoing>F_3_7</bpmn:outgoing>
      <bpmn:outgoing>F_3_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ReturnUnauthorisedRequest" name="Return the unauthorised request to the clinical team">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-return-unauthorised-request" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_7</bpmn:incoming>
      <bpmn:outgoing>F_3_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ValidateTreatmentRequest" name="Validate the authorised request and confirm resource requirements">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-validate-treatment-request" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_9</bpmn:incoming>
      <bpmn:outgoing>F_3_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_RequestTreatmentCapacity" name="Request treatment appointments from external clinical services">
      <bpmn:documentation>Some appointments can be arranged using hospital facilities; others depend on availability obtained from external treatment, laboratory, imaging or scheduling services.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-treatment-capacity" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_10</bpmn:incoming>
      <bpmn:incoming>F_3_12</bpmn:incoming>
      <bpmn:outgoing>F_3_10a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_CapacityConfirmed" name="External treatment capacity confirmed?" default="F_3_11">
      <bpmn:incoming>F_3_10a</bpmn:incoming>
      <bpmn:outgoing>F_3_11</bpmn:outgoing>
      <bpmn:outgoing>F_3_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_KeepPending" name="Keep the booking pending, notify the responsible team and record the retry">
      <bpmn:documentation>Exception path: if an external service is temporarily unavailable the booking must remain pending, the responsible team must be notified and further attempts recorded, without creating duplicate appointments.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-record-pending-booking" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_11</bpmn:incoming>
      <bpmn:outgoing>F_3_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_DetermineFundingRoute" name="Determine the funding route for the treatment">
      <bpmn:documentation>Business rule: the system must determine whether the treatment is funded by the hospital, covered by an approved insurer or funding organisation, or requires payment by the patient.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-determine-funding-route" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_13</bpmn:incoming>
      <bpmn:incoming>F_3_16</bpmn:incoming>
      <bpmn:outgoing>F_3_16a</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_FundingApproved" name="Funding approved or no payment required?" default="F_3_14">
      <bpmn:incoming>F_3_16a</bpmn:incoming>
      <bpmn:outgoing>F_3_14</bpmn:outgoing>
      <bpmn:outgoing>F_3_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_RecordFundingApproval" name="Record the funding organisation, authorisation reference, amount and limitations">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-record-funding-approval" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_15</bpmn:incoming>
      <bpmn:outgoing>F_3_16b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RequestFundingApproval" name="Request funding approval or an additional payment">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-request-funding-approval" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_14</bpmn:incoming>
      <bpmn:outgoing>F_3_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_AdvancePaymentRequired" name="Advance payment required before the appointment is confirmed?" default="F_3_17">
      <bpmn:documentation>Business rule: most eligible patients make no direct payment; charges may apply to private patients, overseas visitors, optional services or treatment not covered by the existing funding arrangement.</bpmn:documentation>
      <bpmn:incoming>F_3_16b</bpmn:incoming>
      <bpmn:outgoing>F_3_17</bpmn:outgoing>
      <bpmn:outgoing>F_3_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_SendSecurePaymentRequest" name="Send the secure payment request to the external payment service provider">
      <bpmn:documentation>The hospital system must not store the complete card information or other unnecessary financial details.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-secure-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_18</bpmn:incoming>
      <bpmn:incoming>F_3_21</bpmn:incoming>
      <bpmn:outgoing>F_3_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_PaymentOutcome" name="Payment outcome returned by the payment service?" default="F_3_20">
      <bpmn:incoming>F_3_19</bpmn:incoming>
      <bpmn:outgoing>F_3_20</bpmn:outgoing>
      <bpmn:outgoing>F_3_22</bpmn:outgoing>
      <bpmn:outgoing>F_3_24</bpmn:outgoing>
      <bpmn:outgoing>F_3_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_RecordPayment" name="Record the payment reference, amount and date against the patient account">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-record-payment" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_22</bpmn:incoming>
      <bpmn:outgoing>F_3_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_HandlePaymentFailure" name="Notify the patient and the responsible team and allow a further attempt">
      <bpmn:documentation>Business rule: a declined, cancelled or incomplete payment must not create a duplicate booking or charge the patient more than once.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-handle-payment-failure" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_20</bpmn:incoming>
      <bpmn:outgoing>F_3_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_MarkForInvestigation" name="Mark the transaction for investigation and do not raise a second payment">
      <bpmn:documentation>Exception path: where the provider took the payment but confirmation was not returned because of a communication failure, the transaction must be marked for investigation rather than automatically requesting another payment.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-mark-payment-investigation" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_24</bpmn:incoming>
      <bpmn:outgoing>F_3_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_AuthoriseUrgentTreatment" name="Authorise urgent treatment without confirmed payment and record the reason">
      <bpmn:documentation>Business rule: clinical staff must still be able to authorise urgent treatment where delaying care would create a risk to the patient, but the reason must be recorded and referred to the Finance Team.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-authorise-urgent-treatment" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="consultant-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_27</bpmn:incoming>
      <bpmn:outgoing>F_3_28</bpmn:outgoing>
      <bpmn:outgoing>F_3_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ResolveTransaction" name="Resolve the outstanding transaction with the provider">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-resolve-payment-transaction" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_25</bpmn:incoming>
      <bpmn:outgoing>F_3_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ReferUnconfirmedPayment" name="Refer the unconfirmed payment to the Finance Team for resolution">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-refer-unconfirmed-payment" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="finance-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_29</bpmn:incoming>
      <bpmn:outgoing>F_3_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_ConfirmTreatmentSchedule" name="Confirm the treatment schedule and issue the patient instructions">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-confirm-treatment-schedule" binding="deployment" />
        <zeebe:assignmentDefinition candidateGroups="treatment-bookings-team" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_3_17</bpmn:incoming>
      <bpmn:incoming>F_3_23</bpmn:incoming>
      <bpmn:incoming>F_3_26</bpmn:incoming>
      <bpmn:incoming>F_3_28</bpmn:incoming>
      <bpmn:incoming>F_3_30</bpmn:incoming>
      <bpmn:outgoing>F_3_31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_TreatmentScheduled" name="Treatment schedule confirmed">
      <bpmn:incoming>F_3_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_1_1" sourceRef="E_ReferralReceived" targetRef="T_ReceiveReferral" />
    <bpmn:sequenceFlow id="F_1_1m" sourceRef="E_ReferralReceivedManual" targetRef="T_ReceiveReferral" />
    <bpmn:sequenceFlow id="F_1_2" sourceRef="T_ReceiveReferral" targetRef="T_CheckReferralDocuments" />
    <bpmn:sequenceFlow id="F_1_6" name="Documents received" sourceRef="T_RequestMissingDocuments" targetRef="T_CheckReferralDocuments" />
    <bpmn:sequenceFlow id="F_1_3" sourceRef="T_CheckReferralDocuments" targetRef="G_DocumentsComplete" />
    <bpmn:sequenceFlow id="F_1_4" name="Documents missing" sourceRef="G_DocumentsComplete" targetRef="T_RequestMissingDocuments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_1_5" name="Documents complete" sourceRef="G_DocumentsComplete" targetRef="T_ClinicalReviewReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_1_13" name="Further information required" sourceRef="G_ReferralDecision" targetRef="T_RequestMissingDocuments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = "information required"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_1_7" sourceRef="T_ClinicalReviewReferral" targetRef="T_RecordReferralDecision" />
    <bpmn:sequenceFlow id="F_1_8" sourceRef="T_RecordReferralDecision" targetRef="G_ReferralDecision" />
    <bpmn:sequenceFlow id="F_1_9" name="Rejected" sourceRef="G_ReferralDecision" targetRef="T_NotifyReferralOutcome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = "rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_1_11" name="Redirected" sourceRef="G_ReferralDecision" targetRef="T_RedirectReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = "redirected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_1_14" name="Accepted" sourceRef="G_ReferralDecision" targetRef="T_ForwardAcceptedReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = "accepted"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_2_1" sourceRef="T_ForwardAcceptedReferral" targetRef="T_ReceiveBookingRequest" />
    <bpmn:sequenceFlow id="F_1_10" sourceRef="T_NotifyReferralOutcome" targetRef="E_ReferralClosed" />
    <bpmn:sequenceFlow id="F_1_12" sourceRef="T_RedirectReferral" targetRef="E_ReferralRedirected" />
    <bpmn:sequenceFlow id="F_2_2" sourceRef="T_ReceiveBookingRequest" targetRef="G_UrgentReferral" />
    <bpmn:sequenceFlow id="F_2_3" name="Urgent" sourceRef="G_UrgentReferral" targetRef="T_ExpediteUrgentBooking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralUrgency = "urgent"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_2_4" name="Routine" sourceRef="G_UrgentReferral" targetRef="T_QueryAvailableSlots">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralUrgency = "routine"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_2_5" sourceRef="T_ExpediteUrgentBooking" targetRef="T_QueryAvailableSlots" />
    <bpmn:sequenceFlow id="F_2_7" name="Capacity reviewed" sourceRef="T_ResolveCapacity" targetRef="T_QueryAvailableSlots" />
    <bpmn:sequenceFlow id="F_2_5a" sourceRef="T_QueryAvailableSlots" targetRef="G_SlotsAvailable" />
    <bpmn:sequenceFlow id="F_2_6" name="No suitable appointment" sourceRef="G_SlotsAvailable" targetRef="T_ResolveCapacity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suitableSlotFound = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_2_8" name="Appointment available" sourceRef="G_SlotsAvailable" targetRef="T_SelectAndBookSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= suitableSlotFound = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_2_9" sourceRef="T_SelectAndBookSlot" targetRef="T_ConfirmBooking" />
    <bpmn:sequenceFlow id="F_2_10" sourceRef="T_ConfirmBooking" targetRef="T_SendAppointmentLetter" />
    <bpmn:sequenceFlow id="F_2_11" sourceRef="T_SendAppointmentLetter" targetRef="G_WithinFourteenDays" />
    <bpmn:sequenceFlow id="F_2_12" name="More than 14 days away" sourceRef="G_WithinFourteenDays" targetRef="T_NewPatientConsultation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentWithin14Days = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_2_13" name="Within 14 days" sourceRef="G_WithinFourteenDays" targetRef="T_TelephonePatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentWithin14Days = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_2_16" name="Unanswered, wrong number or alternative requested" sourceRef="G_ContactSuccessful" targetRef="T_TelephonePatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactSuccessful = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_2_14" sourceRef="T_TelephonePatient" targetRef="T_RecordContactAttempt" />
    <bpmn:sequenceFlow id="F_2_15" sourceRef="T_RecordContactAttempt" targetRef="G_ContactSuccessful" />
    <bpmn:sequenceFlow id="F_2_17" name="Attendance confirmed" sourceRef="G_ContactSuccessful" targetRef="T_NewPatientConsultation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= contactSuccessful = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_1" sourceRef="T_NewPatientConsultation" targetRef="G_PatientConsent" />
    <bpmn:sequenceFlow id="F_3_2" name="Consent given" sourceRef="G_PatientConsent" targetRef="T_RecordPatientConsent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_3" name="Consent refused" sourceRef="G_PatientConsent" targetRef="T_AdviseNoTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= consentGiven = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_4" sourceRef="T_AdviseNoTreatment" targetRef="E_TreatmentDeclined" />
    <bpmn:sequenceFlow id="F_3_5" sourceRef="T_RecordPatientConsent" targetRef="T_CreateTreatmentBookingRequest" />
    <bpmn:sequenceFlow id="F_3_8" name="Request corrected and resubmitted" sourceRef="T_ReturnUnauthorisedRequest" targetRef="T_CreateTreatmentBookingRequest" />
    <bpmn:sequenceFlow id="F_3_6" sourceRef="T_CreateTreatmentBookingRequest" targetRef="G_RequestAuthorised" />
    <bpmn:sequenceFlow id="F_3_7" name="Not authorised" sourceRef="G_RequestAuthorised" targetRef="T_ReturnUnauthorisedRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestAuthorised = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_9" name="Authorised" sourceRef="G_RequestAuthorised" targetRef="T_ValidateTreatmentRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= requestAuthorised = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_10" sourceRef="T_ValidateTreatmentRequest" targetRef="T_RequestTreatmentCapacity" />
    <bpmn:sequenceFlow id="F_3_12" name="Retry without duplicate booking" sourceRef="T_KeepPending" targetRef="T_RequestTreatmentCapacity" />
    <bpmn:sequenceFlow id="F_3_10a" sourceRef="T_RequestTreatmentCapacity" targetRef="G_CapacityConfirmed" />
    <bpmn:sequenceFlow id="F_3_11" name="Not confirmed" sourceRef="G_CapacityConfirmed" targetRef="T_KeepPending">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentCapacityConfirmed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_13" name="Confirmed" sourceRef="G_CapacityConfirmed" targetRef="T_DetermineFundingRoute">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentCapacityConfirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_16" name="Approval recorded" sourceRef="T_RequestFundingApproval" targetRef="T_DetermineFundingRoute" />
    <bpmn:sequenceFlow id="F_3_16a" sourceRef="T_DetermineFundingRoute" targetRef="G_FundingApproved" />
    <bpmn:sequenceFlow id="F_3_14" name="Approval required" sourceRef="G_FundingApproved" targetRef="T_RequestFundingApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_15" name="Approved or not required" sourceRef="G_FundingApproved" targetRef="T_RecordFundingApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= fundingApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_16b" sourceRef="T_RecordFundingApproval" targetRef="G_AdvancePaymentRequired" />
    <bpmn:sequenceFlow id="F_3_17" name="No advance payment" sourceRef="G_AdvancePaymentRequired" targetRef="T_ConfirmTreatmentSchedule" />
    <bpmn:sequenceFlow id="F_3_18" name="Advance payment required" sourceRef="G_AdvancePaymentRequired" targetRef="T_SendSecurePaymentRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= advancePaymentRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_21" name="Further attempt authorised" sourceRef="T_HandlePaymentFailure" targetRef="T_SendSecurePaymentRequest" />
    <bpmn:sequenceFlow id="F_3_19" sourceRef="T_SendSecurePaymentRequest" targetRef="G_PaymentOutcome" />
    <bpmn:sequenceFlow id="F_3_20" name="Declined, cancelled or incomplete" sourceRef="G_PaymentOutcome" targetRef="T_HandlePaymentFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "declined"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_22" name="Payment confirmed" sourceRef="G_PaymentOutcome" targetRef="T_RecordPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "confirmed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_24" name="Confirmation not returned" sourceRef="G_PaymentOutcome" targetRef="T_MarkForInvestigation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "no response"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_27" name="Urgent clinical need" sourceRef="G_PaymentOutcome" targetRef="T_AuthoriseUrgentTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "urgent clinical need"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3_23" sourceRef="T_RecordPayment" targetRef="T_ConfirmTreatmentSchedule" />
    <bpmn:sequenceFlow id="F_3_25" sourceRef="T_MarkForInvestigation" targetRef="T_ResolveTransaction" />
    <bpmn:sequenceFlow id="F_3_28" name="Treatment proceeds on clinical grounds" sourceRef="T_AuthoriseUrgentTreatment" targetRef="T_ConfirmTreatmentSchedule" />
    <bpmn:sequenceFlow id="F_3_29" name="Refer for financial resolution" sourceRef="T_AuthoriseUrgentTreatment" targetRef="T_ReferUnconfirmedPayment" />
    <bpmn:sequenceFlow id="F_3_26" sourceRef="T_ResolveTransaction" targetRef="T_ConfirmTreatmentSchedule" />
    <bpmn:sequenceFlow id="F_3_30" sourceRef="T_ReferUnconfirmedPayment" targetRef="T_ConfirmTreatmentSchedule" />
    <bpmn:sequenceFlow id="F_3_31" sourceRef="T_ConfirmTreatmentSchedule" targetRef="E_TreatmentScheduled" />
    <bpmn:sendTask id="T_NotifyReferralOutcome" name="Notify the referring organisation of the referral decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-referral-outcome" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_1_9</bpmn:incoming>
      <bpmn:outgoing>F_1_10</bpmn:outgoing>
    </bpmn:sendTask>
  </bpmn:process>
  <bpmn:process id="PR_ReferringOrganisation" name="Referring organisation: submission of the referral and receipt of the outcome" isExecutable="true">
    <bpmn:startEvent id="RO_ReferralRequired" name="Referral required">
      <bpmn:outgoing>RO_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="RO_ComposeReferral" name="Compose and validate the patient referral">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="referring-org-submit-patient-referral" />
      </bpmn:extensionElements>
      <bpmn:incoming>RO_F1</bpmn:incoming>
      <bpmn:outgoing>RO_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="RO_AwaitOutcome" name="Referral outcome received">
      <bpmn:incoming>RO_F3</bpmn:incoming>
      <bpmn:outgoing>RO_F4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="RO_AwaitOutcome_msgdef" messageRef="Msg_ReferralOutcome" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="RO_OutcomeRecorded" name="Outcome recorded in the referring record">
      <bpmn:incoming>RO_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="RO_SendReferral" name="Send the patient referral to the hospital">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="referring-org-publish-patient-referral" />
      </bpmn:extensionElements>
      <bpmn:incoming>RO_F2</bpmn:incoming>
      <bpmn:outgoing>RO_F3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="RO_SendReferral_msgdef" messageRef="Msg_Referral" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="RO_F1" sourceRef="RO_ReferralRequired" targetRef="RO_ComposeReferral" />
    <bpmn:sequenceFlow id="RO_F2" sourceRef="RO_ComposeReferral" targetRef="RO_SendReferral" />
    <bpmn:sequenceFlow id="RO_F3" sourceRef="RO_SendReferral" targetRef="RO_AwaitOutcome" />
    <bpmn:sequenceFlow id="RO_F4" sourceRef="RO_AwaitOutcome" targetRef="RO_OutcomeRecorded" />
  </bpmn:process>
