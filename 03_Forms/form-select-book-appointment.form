{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Select and book the new patient appointment",
      "id": "Header_form-select-book-appointment",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "appointmentWithin14Days",
      "label": "Appointment due within the next 14 days?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "appointmentReference",
      "label": "Appointment reference recorded by the bookings team",
      "type": "textfield"
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    },
    {
      "type": "datetime",
      "key": "appointmentDate",
      "label": "Date of the booked appointment",
      "subtype": "date",
      "validate": {
        "required": true
      }
    },
    {
      "type": "textfield",
      "key": "requestedSpeciality",
      "label": "Requested speciality or service",
      "validate": {
        "maxLength": 80,
        "required": true
      }
    },
    {
      "type": "number",
      "key": "preferredTimeframeDays",
      "label": "Requested booking timeframe, in days",
      "validate": {
        "max": 365,
        "min": 1,
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-select-book-appointment",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
