{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Validate the authorised request and confirm resource requirements",
      "id": "Header_form-validate-treatment-request",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "treatmentCapacityConfirmed",
      "label": "External treatment capacity confirmed?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    },
    {
      "type": "number",
      "key": "treatmentCycles",
      "label": "Number of treatment cycles confirmed",
      "validate": {
        "max": 12,
        "min": 1,
        "required": true
      }
    },
    {
      "type": "textfield",
      "key": "requiredResource",
      "label": "Resource confirmed for the request",
      "validate": {
        "maxLength": 80,
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-validate-treatment-request",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
