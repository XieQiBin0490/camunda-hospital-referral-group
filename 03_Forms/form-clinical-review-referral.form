{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Perform the clinical review of the referral",
      "id": "Header_form-clinical-review-referral",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "referralDecision",
      "label": "Referral decision (accepted / rejected / information required / redirected)",
      "type": "select",
      "values": [
        {
          "label": "Accepted",
          "value": "accepted"
        },
        {
          "label": "Rejected",
          "value": "rejected"
        },
        {
          "label": "Information required",
          "value": "information required"
        },
        {
          "label": "Redirected",
          "value": "redirected"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-clinical-review-referral",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
