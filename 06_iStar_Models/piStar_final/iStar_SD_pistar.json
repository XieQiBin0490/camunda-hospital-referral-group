{
  "actors": [
    {
      "id": "A_PAT",
      "text": "Patient / Representative",
      "type": "istar.Actor",
      "x": 780,
      "y": 891,
      "customProperties": {
        "Description": "The person receiving care, or a representative acting with authority. Wants clinically appropriate, timely treatment; supplies identity, contact and consent information."
      },
      "nodes": []
    },
    {
      "id": "A_REF",
      "text": "Referring Organisation",
      "type": "istar.Actor",
      "x": 675,
      "y": 1062,
      "customProperties": {
        "Description": "The GP practice or hospital that refers the patient and supplies the referral documentation."
      },
      "nodes": []
    },
    {
      "id": "A_MS",
      "text": "Medical Secretaries",
      "type": "istar.Actor",
      "x": 670,
      "y": 1214,
      "customProperties": {
        "Description": "Receive and check referrals, request missing documents, process approved clinic letters and distribute them. They may not make clinical judgements."
      },
      "nodes": []
    },
    {
      "id": "A_CON",
      "text": "Consultant Team",
      "type": "istar.Actor",
      "x": 296,
      "y": 1874,
      "customProperties": {
        "Description": "Accepts, rejects, redirects or requests more information on a referral; records the decision and reason; obtains consent; authorises treatment; approves clinic letters."
      },
      "nodes": []
    },
    {
      "id": "A_CNS",
      "text": "CNS Team",
      "type": "istar.Actor",
      "x": 1086,
      "y": 631,
      "customProperties": {
        "Description": "Provides clinical advice and support, answers clinical enquiries and handles urgent clinical concerns."
      },
      "nodes": []
    },
    {
      "id": "A_OB",
      "text": "Outpatient Bookings",
      "type": "istar.Actor",
      "x": 1224,
      "y": 735,
      "customProperties": {
        "Description": "Finds and confirms new-patient and follow-up appointments, records contact attempts and escalates capacity exceptions."
      },
      "nodes": []
    },
    {
      "id": "A_TB",
      "text": "Treatment Bookings",
      "type": "istar.Actor",
      "x": 1059,
      "y": 1305,
      "customProperties": {
        "Description": "Validates authorised treatment requests and coordinates treatment, laboratory and imaging capacity without duplicating bookings."
      },
      "nodes": []
    },
    {
      "id": "A_PPC",
      "text": "Pathway Coordinators",
      "type": "istar.Actor",
      "x": 1280,
      "y": 1811,
      "customProperties": {
        "Description": "Monitors pathways, reminds Consultants about outstanding letters, escalates persistent delays and resolves capacity exceptions."
      },
      "nodes": []
    },
    {
      "id": "A_CH",
      "text": "Call Handling",
      "type": "istar.Actor",
      "x": 1912,
      "y": 584,
      "customProperties": {
        "Description": "Records, classifies, prioritises and routes patient enquiries; may answer administrative questions but must not give clinical advice."
      },
      "nodes": []
    },
    {
      "id": "A_COR",
      "text": "Correspondence Service",
      "type": "istar.Actor",
      "x": 1550,
      "y": 860,
      "customProperties": {
        "Description": "Prints and distributes appointment and clinic letters through approved channels."
      },
      "nodes": []
    },
    {
      "id": "A_SCH",
      "text": "Scheduling Service",
      "type": "istar.Actor",
      "x": 1718,
      "y": 1289,
      "customProperties": {
        "Description": "Supplies available appointment slots. The hospital cannot create capacity it does not have."
      },
      "nodes": []
    },
    {
      "id": "A_CLIN",
      "text": "Clinical Services",
      "type": "istar.Actor",
      "x": 1386,
      "y": 1550,
      "customProperties": {
        "Description": "Provides treatment capacity and the laboratory, imaging and assessment results on which clinical decisions depend."
      },
      "nodes": []
    },
    {
      "id": "A_FIN",
      "text": "Finance Team",
      "type": "istar.Actor",
      "x": 2830,
      "y": 808,
      "customProperties": {
        "Description": "Determines the funding route, records approval, sends secure payment requests, investigates unconfirmed payments and decides refunds under financial authority."
      },
      "nodes": []
    },
    {
      "id": "A_FUND",
      "text": "Funder / Insurer",
      "type": "istar.Actor",
      "x": 2275,
      "y": 1051,
      "customProperties": {
        "Description": "Approves funding and states the authorised amount and any limitations."
      },
      "nodes": []
    },
    {
      "id": "A_PSP",
      "text": "Payment Provider",
      "type": "istar.Actor",
      "x": 2391,
      "y": 1217,
      "customProperties": {
        "Description": "Processes card payments and refunds and returns the status, transaction reference, date and amount."
      },
      "nodes": []
    },
    {
      "id": "A_MGMT",
      "text": "Management",
      "type": "istar.Actor",
      "x": 2369,
      "y": 1463,
      "customProperties": {
        "Description": "Needs reports on referrals, waiting times, delayed letters, enquiries, funding, payments and refunds; receives escalations."
      },
      "nodes": []
    }
  ],
