{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Check referral documentation completeness",
      "id": "Header_form-check-referral-documents",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "documentsComplete",
      "label": "All expected supporting documents available?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    },
    {
      "type": "textarea",
      "key": "missingDocuments",
      "label": "Documents missing from the referral (list them)",
      "validate": {
        "maxLength": 500
      }
    }
  ],
  "type": "default",
  "id": "form-check-referral-documents",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
