{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Record the urgent postponement for patient safety and obtain retrospective authorisation",
      "id": "Header_form-urgent-postponement",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "financialImpact",
      "label": "Modification affects a charge, funding approval or payment?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-urgent-postponement",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
