<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %-46logger{0} %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Zeebe's own transport logging is useful once, then noise. -->
  <logger name="io.camunda.zeebe.client" level="WARN"/>
  <logger name="io.grpc" level="WARN"/>
  <logger name="io.netty" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
