{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Schedule and deliver the treatment cycles",
      "id": "Header_form-deliver-treatment-cycle",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "letterDelayDays",
      "label": "Delay in producing the letter, in days",
      "type": "number",
      "validate": {
        "max": 365,
        "min": 0,
        "required": true
      }
    },
    {
      "key": "furtherCyclesPlanned",
      "label": "Further treatment cycles planned?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    },
    {
      "type": "textfield",
      "key": "cycleReference",
      "label": "Treatment cycle reference",
      "validate": {
        "maxLength": 40
      }
    },
    {
      "type": "datetime",
      "key": "treatmentCycleDate",
      "label": "Date the cycle was administered",
      "subtype": "date"
    }
  ],
  "type": "default",
  "id": "form-deliver-treatment-cycle",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
