{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Record the payment reference, amount and date against the patient account",
      "id": "Header_form-record-payment",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    },
    {
      "type": "textfield",
      "key": "paymentReference",
      "label": "Payment reference returned by the provider",
      "validate": {
        "maxLength": 40,
        "required": true
      }
    },
    {
      "type": "number",
      "key": "paymentAmount",
      "label": "Amount paid, in whole GBP",
      "validate": {
        "min": 0,
        "required": true
      }
    },
    {
      "type": "datetime",
      "key": "paymentDate",
      "label": "Date the payment was taken",
      "subtype": "date",
      "validate": {
        "required": true
      }
    },
    {
      "type": "select",
      "key": "currency",
      "label": "Currency",
      "values": [
        {
          "label": "Pound sterling (GBP)",
          "value": "GBP"
        },
        {
          "label": "Euro (EUR)",
          "value": "EUR"
        },
        {
          "label": "US dollar (USD)",
          "value": "USD"
        }
      ],
      "validate": {
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-record-payment",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
