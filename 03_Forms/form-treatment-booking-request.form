{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Create the authorised Treatment Booking Request",
      "id": "Header_form-treatment-booking-request",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "requestAuthorised",
      "label": "Request completed and authorised by a clinical professional?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    },
    {
      "type": "textfield",
      "key": "treatmentCode",
      "label": "Treatment or procedure code",
      "validate": {
        "maxLength": 40,
        "required": true
      }
    },
    {
      "type": "number",
      "key": "treatmentCycles",
      "label": "Number of treatment cycles requested",
      "validate": {
        "max": 12,
        "min": 1,
        "required": true
      }
    },
    {
      "type": "textfield",
      "key": "requiredResource",
      "label": "Resource required (for example chair, bed, theatre)",
      "validate": {
        "maxLength": 80,
        "required": true
      }
    },
    {
      "type": "number",
      "key": "chargeAmount",
      "label": "Charge to the patient for this request, in whole GBP",
      "validate": {
        "min": 0,
        "required": true
      }
    },
    {
      "type": "select",
      "key": "currency",
      "label": "Currency",
      "values": [
        {
          "label": "Pound sterling (GBP)",
          "value": "GBP"
        },
        {
          "label": "Euro (EUR)",
          "value": "EUR"
        },
        {
          "label": "US dollar (USD)",
          "value": "USD"
        }
      ],
      "validate": {
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-treatment-booking-request",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
