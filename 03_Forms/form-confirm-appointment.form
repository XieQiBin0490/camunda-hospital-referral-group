{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Confirm the booking and record the appointment reference",
      "id": "Header_form-confirm-appointment",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "appointmentWithin14Days",
      "label": "Appointment due within the next 14 days?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "appointmentReference",
      "label": "Appointment reference recorded by the bookings team",
      "type": "textfield"
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-confirm-appointment",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
