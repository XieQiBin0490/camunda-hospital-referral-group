{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Review performance reports and agree corrective action",
      "id": "Header_form-review-management-reports",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    },
    {
      "type": "textfield",
      "key": "reportPeriod",
      "label": "Reporting period (YYYY-MM)",
      "validate": {
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-review-management-reports",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
