{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Keep the booking pending, notify the responsible team and record the retry",
      "id": "Header_form-record-pending-booking",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "treatmentCapacityConfirmed",
      "label": "External treatment capacity confirmed?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    },
    {
      "type": "textfield",
      "key": "requiredResource",
      "label": "Resource that could not be confirmed",
      "validate": {
        "maxLength": 80,
        "required": true
      }
    },
    {
      "type": "number",
      "key": "preferredTimeframeDays",
      "label": "Requested timeframe that could not be met, in days",
      "validate": {
        "max": 365,
        "min": 1
      }
    }
  ],
  "type": "default",
  "id": "form-record-pending-booking",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
