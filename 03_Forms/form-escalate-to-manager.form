{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Escalate to the Administrative Manager, who contacts the consultant",
      "id": "Header_form-escalate-to-manager",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "letterAgeMonths",
      "label": "Age of the outstanding letter, in months",
      "type": "number",
      "validate": {
        "max": 120,
        "min": 0,
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-escalate-to-manager",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
