<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_HospitalPatientAdministration" targetNamespace="http://example.com/hospital-patient-administration" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:collaboration id="Collaboration_HospitalPatientAdministration">
    <bpmn:participant id="Participant_Hospital" name="Hospital Patient Administration" processRef="Process_HospitalPatientAdministration" />
    <bpmn:participant id="Participant_Scheduling" name="External Scheduling Service" />
    <bpmn:participant id="Participant_Correspondence" name="External Correspondence Service" />
    <bpmn:participant id="Participant_Payment" name="External Payment Service Provider" />
    <bpmn:messageFlow id="MessageFlow_SchedulingRequest" name="Appointment request" sourceRef="Task_FindAppointment" targetRef="Participant_Scheduling" />
    <bpmn:messageFlow id="MessageFlow_AppointmentLetter" name="Appointment letter request" sourceRef="Task_SendAppointmentLetter" targetRef="Participant_Correspondence" />
    <bpmn:messageFlow id="MessageFlow_PaymentRequest" name="Secure payment request" sourceRef="Task_CreatePaymentRequest" targetRef="Participant_Payment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_HospitalPatientAdministration" name="Hospital Patient Administration" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Hospital">
      <bpmn:lane id="Lane_Finance" name="Finance Team">
        <bpmn:flowNodeRef>Task_CheckFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreatePaymentRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckPaymentStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentSuccessful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandlePaymentFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RetryPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InvestigatePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvideTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClinicalReviewAfterTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoreTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScheduleNextCycle</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Booking">
        <bpmn:flowNodeRef>Task_FindAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AppointmentAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalateAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WithinTwoWeeks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TelephonePatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAppointmentLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PatientAttends</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordDNA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyPathwayTeam</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Consultation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TreatmentRequired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordConsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateTreatmentBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArrangeTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExternalServiceAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkTreatmentPending</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consultant" name="Consultant / Clinical Team">
        <bpmn:flowNodeRef>Task_ClinicalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReferralDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RedirectReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Redirected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveClinicLetter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretary" name="Medical Secretary">
        <bpmn:flowNodeRef>StartEvent_ReferralReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WaitForInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateClinicLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessClinicLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ReferralReceived" name="Referral Received">
      <bpmn:outgoing>Flow_Start_Check</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CheckReferral" name="Check Referral Documents">
      <bpmn:incoming>Flow_Start_Check</bpmn:incoming>
      <bpmn:incoming>Flow_Info_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_DocGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DocumentsComplete" name="Documents Complete?" default="Flow_DocYes">
      <bpmn:incoming>Flow_Check_DocGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DocYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DocNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RequestInformation" name="Request Missing Information">
      <bpmn:incoming>Flow_DocNo</bpmn:incoming>
      <bpmn:outgoing>Flow_Request_Wait</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_WaitForInformation" name="Wait for Additional Information">
      <bpmn:incoming>Flow_Request_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_Info_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ClinicalReview" name="Consultant Clinical Review">
      <bpmn:incoming>Flow_DocYes</bpmn:incoming>
      <bpmn:incoming>Flow_DecisionMoreInfo</bpmn:incoming>
      <bpmn:outgoing>Flow_Review_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReferralDecision" name="Referral Decision">
      <bpmn:incoming>Flow_Review_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_DecisionAccept</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecisionReject</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecisionMoreInfo</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecisionRedirect</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RecordDecision" name="Record Referral Decision and Reason">
      <bpmn:incoming>Flow_DecisionAccept</bpmn:incoming>
      <bpmn:outgoing>Flow_Record_FindAppointment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RecordRejection" name="Record Rejection">
      <bpmn:incoming>Flow_DecisionReject</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejection_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_RedirectReferral" name="Redirect Referral">
      <bpmn:incoming>Flow_DecisionRedirect</bpmn:incoming>
      <bpmn:outgoing>Flow_Redirect_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Rejected" name="Referral Rejected">
      <bpmn:incoming>Flow_Rejection_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Redirected" name="Referral Redirected">
      <bpmn:incoming>Flow_Redirect_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_FindAppointment" name="Find Appointment" zeebe:modelerTemplate="com.example.findAppointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="find-appointment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Record_FindAppointment</bpmn:incoming>
      <bpmn:outgoing>Flow_Find_Available</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AppointmentAvailable" name="Appointment Available?" default="Flow_ApptYes">
      <bpmn:incoming>Flow_Find_Available</bpmn:incoming>
      <bpmn:outgoing>Flow_ApptYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApptNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EscalateAppointment" name="Escalate Appointment Delay">
      <bpmn:incoming>Flow_ApptNo</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_Find</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_WithinTwoWeeks" name="Appointment Within Two Weeks?" default="Flow_NotWithinTwoWeeks">
      <bpmn:incoming>Flow_ApptYes</bpmn:incoming>
      <bpmn:outgoing>Flow_WithinTwoWeeks</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotWithinTwoWeeks</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_TelephonePatient" name="Telephone Patient">
      <bpmn:incoming>Flow_WithinTwoWeeks</bpmn:incoming>
      <bpmn:outgoing>Flow_Telephone_Letter</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SendAppointmentLetter" name="Send Appointment Letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-appointment-letter" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotWithinTwoWeeks</bpmn:incoming>
      <bpmn:incoming>Flow_Telephone_Letter</bpmn:incoming>
      <bpmn:outgoing>Flow_Letter_Attends</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PatientAttends" name="Patient Attends?" default="Flow_AttendsYes">
      <bpmn:incoming>Flow_Letter_Attends</bpmn:incoming>
      <bpmn:outgoing>Flow_AttendsYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_AttendsNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RecordDNA" name="Record DNA / Review Pathway">
      <bpmn:incoming>Flow_AttendsNo</bpmn:incoming>
      <bpmn:outgoing>Flow_DNA_Notify</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_NotifyPathwayTeam" name="Notify Pathway Team">
      <bpmn:incoming>Flow_DNA_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Notify_Letter</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Consultation" name="Conduct Consultation">
      <bpmn:incoming>Flow_AttendsYes</bpmn:incoming>
      <bpmn:outgoing>Flow_Consultation_TreatmentGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TreatmentRequired" name="Treatment Required?" default="Flow_NoTreatment_Letter">
      <bpmn:incoming>Flow_Consultation_TreatmentGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_TreatmentYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoTreatment_Letter</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RecordConsent" name="Record Consent">
      <bpmn:incoming>Flow_TreatmentYes</bpmn:incoming>
      <bpmn:outgoing>Flow_Consent_Booking</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CreateTreatmentBooking" name="Create Authorised Treatment Booking Request">
      <bpmn:incoming>Flow_Consent_Booking</bpmn:incoming>
      <bpmn:incoming>Flow_ScheduleNext_Booking</bpmn:incoming>
      <bpmn:outgoing>Flow_Booking_Arrange</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ArrangeTreatment" name="Arrange Treatment Appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="arrange-treatment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Booking_Arrange</bpmn:incoming>
      <bpmn:outgoing>Flow_Arrange_ServiceGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ExternalServiceAvailable" name="External Service Available?" default="Flow_ServiceYes">
      <bpmn:incoming>Flow_Arrange_ServiceGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ServiceYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ServiceNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_MarkTreatmentPending" name="Mark Treatment Pending and Notify Team">
      <bpmn:incoming>Flow_ServiceNo</bpmn:incoming>
      <bpmn:outgoing>Flow_Pending_Arrange</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CheckFunding" name="Check Funding" zeebe:modelerTemplate="com.example.checkFunding">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-funding" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ServiceYes</bpmn:incoming>
      <bpmn:outgoing>Flow_Funding_PaymentGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PaymentRequired" name="Payment Required?" default="Flow_NoPayment_Treatment">
      <bpmn:incoming>Flow_Funding_PaymentGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoPayment_Treatment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreatePaymentRequest" name="Create Secure Payment Request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-payment-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentYes</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentRequest_Status</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckPaymentStatus" name="Check Payment Status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-payment-status" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentRequest_Status</bpmn:incoming>
      <bpmn:incoming>Flow_Retry_Status</bpmn:incoming>
      <bpmn:outgoing>Flow_Status_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PaymentSuccessful" name="Payment Successful?" default="Flow_PaymentSuccess">
      <bpmn:incoming>Flow_Status_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentSuccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentFailed</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentMissing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_HandlePaymentFailure" name="Handle Payment Failure">
      <bpmn:incoming>Flow_PaymentFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_Failure_Retry</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_RetryPayment" name="Retry Payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retry-payment" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Failure_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_Status</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_InvestigatePayment" name="Investigate Missing Payment Confirmation">
      <bpmn:incoming>Flow_PaymentMissing</bpmn:incoming>
      <bpmn:outgoing>Flow_Investigation_Treatment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ProvideTreatment" name="Provide / Confirm Treatment">
      <bpmn:incoming>Flow_PaymentSuccess</bpmn:incoming>
      <bpmn:incoming>Flow_NoPayment_Treatment</bpmn:incoming>
      <bpmn:incoming>Flow_Investigation_Treatment</bpmn:incoming>
      <bpmn:outgoing>Flow_Treatment_ClinicalReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ClinicalReviewAfterTreatment" name="Clinical Review After Treatment">
      <bpmn:incoming>Flow_Treatment_ClinicalReview</bpmn:incoming>
      <bpmn:outgoing>Flow_Clinical_MoreTreatment</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MoreTreatment" name="More Treatment Needed?" default="Flow_NoMoreTreatment_Letter">
      <bpmn:incoming>Flow_Clinical_MoreTreatment</bpmn:incoming>
      <bpmn:outgoing>Flow_MoreTreatment</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoMoreTreatment_Letter</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ScheduleNextCycle" name="Schedule Next Treatment Cycle">
      <bpmn:incoming>Flow_MoreTreatment</bpmn:incoming>
      <bpmn:outgoing>Flow_ScheduleNext_Booking</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CreateClinicLetter" name="Create Clinic Letter">
      <bpmn:incoming>Flow_NoTreatment_Letter</bpmn:incoming>
      <bpmn:incoming>Flow_NoMoreTreatment_Letter</bpmn:incoming>
      <bpmn:incoming>Flow_Notify_Letter</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateLetter_Approve</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ApproveClinicLetter" name="Consultant Approves Clinic Letter">
      <bpmn:incoming>Flow_CreateLetter_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve_Process</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ProcessClinicLetter" name="Process and Send Clinic Letter">
      <bpmn:incoming>Flow_Approve_Process</bpmn:incoming>
      <bpmn:outgoing>Flow_Process_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_End" name="Case Completed">
      <bpmn:incoming>Flow_Process_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Check" sourceRef="StartEvent_ReferralReceived" targetRef="Task_CheckReferral" />
    <bpmn:sequenceFlow id="Flow_Info_Check" sourceRef="Task_WaitForInformation" targetRef="Task_CheckReferral" />
    <bpmn:sequenceFlow id="Flow_Check_DocGateway" sourceRef="Task_CheckReferral" targetRef="Gateway_DocumentsComplete" />
    <bpmn:sequenceFlow id="Flow_DocYes" name="Yes" sourceRef="Gateway_DocumentsComplete" targetRef="Task_ClinicalReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DocNo" name="No" sourceRef="Gateway_DocumentsComplete" targetRef="Task_RequestInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= documentsComplete = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DecisionMoreInfo" name="More information" sourceRef="Gateway_ReferralDecision" targetRef="Task_RequestInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = "moreInfo"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Request_Wait" sourceRef="Task_RequestInformation" targetRef="Task_WaitForInformation" />
    <bpmn:sequenceFlow id="Flow_Review_Decision" sourceRef="Task_ClinicalReview" targetRef="Gateway_ReferralDecision" />
    <bpmn:sequenceFlow id="Flow_DecisionAccept" name="Accept" sourceRef="Gateway_ReferralDecision" targetRef="Task_RecordDecision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = "accept"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DecisionReject" name="Reject" sourceRef="Gateway_ReferralDecision" targetRef="Task_RecordRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DecisionRedirect" name="Redirect" sourceRef="Gateway_ReferralDecision" targetRef="Task_RedirectReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= referralDecision = "redirect"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Record_FindAppointment" sourceRef="Task_RecordDecision" targetRef="Task_FindAppointment" />
    <bpmn:sequenceFlow id="Flow_Rejection_End" sourceRef="Task_RecordRejection" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_Redirect_End" sourceRef="Task_RedirectReferral" targetRef="EndEvent_Redirected" />
    <bpmn:sequenceFlow id="Flow_Escalate_Find" sourceRef="Task_EscalateAppointment" targetRef="Task_FindAppointment" />
    <bpmn:sequenceFlow id="Flow_Find_Available" sourceRef="Task_FindAppointment" targetRef="Gateway_AppointmentAvailable" />
    <bpmn:sequenceFlow id="Flow_ApptYes" name="Yes" sourceRef="Gateway_AppointmentAvailable" targetRef="Gateway_WithinTwoWeeks">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApptNo" name="No" sourceRef="Gateway_AppointmentAvailable" targetRef="Task_EscalateAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= appointmentAvailable = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_WithinTwoWeeks" name="Yes" sourceRef="Gateway_WithinTwoWeeks" targetRef="Task_TelephonePatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= withinTwoWeeks = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotWithinTwoWeeks" name="No" sourceRef="Gateway_WithinTwoWeeks" targetRef="Task_SendAppointmentLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= withinTwoWeeks = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Telephone_Letter" sourceRef="Task_TelephonePatient" targetRef="Task_SendAppointmentLetter" />
    <bpmn:sequenceFlow id="Flow_Letter_Attends" sourceRef="Task_SendAppointmentLetter" targetRef="Gateway_PatientAttends" />
    <bpmn:sequenceFlow id="Flow_AttendsYes" name="Yes" sourceRef="Gateway_PatientAttends" targetRef="Task_Consultation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= patientAttends = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AttendsNo" name="No" sourceRef="Gateway_PatientAttends" targetRef="Task_RecordDNA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= patientAttends = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DNA_Notify" sourceRef="Task_RecordDNA" targetRef="Task_NotifyPathwayTeam" />
    <bpmn:sequenceFlow id="Flow_Notify_Letter" sourceRef="Task_NotifyPathwayTeam" targetRef="Task_CreateClinicLetter" />
    <bpmn:sequenceFlow id="Flow_Consultation_TreatmentGateway" sourceRef="Task_Consultation" targetRef="Gateway_TreatmentRequired" />
    <bpmn:sequenceFlow id="Flow_TreatmentYes" name="Yes" sourceRef="Gateway_TreatmentRequired" targetRef="Task_RecordConsent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoTreatment_Letter" name="No" sourceRef="Gateway_TreatmentRequired" targetRef="Task_CreateClinicLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= treatmentRequired = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Consent_Booking" sourceRef="Task_RecordConsent" targetRef="Task_CreateTreatmentBooking" />
    <bpmn:sequenceFlow id="Flow_ScheduleNext_Booking" sourceRef="Task_ScheduleNextCycle" targetRef="Task_CreateTreatmentBooking" />
    <bpmn:sequenceFlow id="Flow_Booking_Arrange" sourceRef="Task_CreateTreatmentBooking" targetRef="Task_ArrangeTreatment" />
    <bpmn:sequenceFlow id="Flow_Pending_Arrange" sourceRef="Task_MarkTreatmentPending" targetRef="Task_ArrangeTreatment" />
    <bpmn:sequenceFlow id="Flow_Arrange_ServiceGateway" sourceRef="Task_ArrangeTreatment" targetRef="Gateway_ExternalServiceAvailable" />
    <bpmn:sequenceFlow id="Flow_ServiceYes" name="Yes" sourceRef="Gateway_ExternalServiceAvailable" targetRef="Task_CheckFunding">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalServiceAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ServiceNo" name="No" sourceRef="Gateway_ExternalServiceAvailable" targetRef="Task_MarkTreatmentPending">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= externalServiceAvailable = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Funding_PaymentGateway" sourceRef="Task_CheckFunding" targetRef="Gateway_PaymentRequired" />
    <bpmn:sequenceFlow id="Flow_PaymentYes" name="Yes" sourceRef="Gateway_PaymentRequired" targetRef="Task_CreatePaymentRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoPayment_Treatment" name="No" sourceRef="Gateway_PaymentRequired" targetRef="Task_ProvideTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentRequired = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentRequest_Status" sourceRef="Task_CreatePaymentRequest" targetRef="Task_CheckPaymentStatus" />
    <bpmn:sequenceFlow id="Flow_Retry_Status" sourceRef="Task_RetryPayment" targetRef="Task_CheckPaymentStatus" />
    <bpmn:sequenceFlow id="Flow_Status_Gateway" sourceRef="Task_CheckPaymentStatus" targetRef="Gateway_PaymentSuccessful" />
    <bpmn:sequenceFlow id="Flow_PaymentSuccess" name="Successful" sourceRef="Gateway_PaymentSuccessful" targetRef="Task_ProvideTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "successful"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentFailed" name="Failed / Cancelled" sourceRef="Gateway_PaymentSuccessful" targetRef="Task_HandlePaymentFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "failed" or paymentStatus = "cancelled"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PaymentMissing" name="Confirmation missing" sourceRef="Gateway_PaymentSuccessful" targetRef="Task_InvestigatePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= paymentStatus = "confirmationMissing"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Failure_Retry" sourceRef="Task_HandlePaymentFailure" targetRef="Task_RetryPayment" />
    <bpmn:sequenceFlow id="Flow_Investigation_Treatment" sourceRef="Task_InvestigatePayment" targetRef="Task_ProvideTreatment" />
    <bpmn:sequenceFlow id="Flow_Treatment_ClinicalReview" sourceRef="Task_ProvideTreatment" targetRef="Task_ClinicalReviewAfterTreatment" />
    <bpmn:sequenceFlow id="Flow_Clinical_MoreTreatment" sourceRef="Task_ClinicalReviewAfterTreatment" targetRef="Gateway_MoreTreatment" />
    <bpmn:sequenceFlow id="Flow_MoreTreatment" name="Yes" sourceRef="Gateway_MoreTreatment" targetRef="Task_ScheduleNextCycle">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= moreTreatmentNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoMoreTreatment_Letter" name="No" sourceRef="Gateway_MoreTreatment" targetRef="Task_CreateClinicLetter">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= moreTreatmentNeeded = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CreateLetter_Approve" sourceRef="Task_CreateClinicLetter" targetRef="Task_ApproveClinicLetter" />
    <bpmn:sequenceFlow id="Flow_Approve_Process" sourceRef="Task_ApproveClinicLetter" targetRef="Task_ProcessClinicLetter" />
    <bpmn:sequenceFlow id="Flow_Process_End" sourceRef="Task_ProcessClinicLetter" targetRef="EndEvent_End" />
  </bpmn:process>
