{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Request a follow-up appointment within the clinically specified period",
      "id": "Header_form-request-follow-up",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "followUpSlotWithinPeriod",
      "label": "Follow-up appointment found within the requested period?",
      "type": "checkbox",
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    },
    {
      "type": "number",
      "key": "preferredTimeframeDays",
      "label": "Clinically specified follow-up period, in days",
      "validate": {
        "max": 365,
        "min": 1,
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-request-follow-up",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
