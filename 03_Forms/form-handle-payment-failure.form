{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Notify the patient and the responsible team and allow a further attempt",
      "id": "Header_form-handle-payment-failure",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "paymentStatus",
      "label": "Payment status (confirmed / declined / no response / urgent clinical need)",
      "type": "select",
      "values": [
        {
          "label": "Confirmed",
          "value": "confirmed"
        },
        {
          "label": "Declined",
          "value": "declined"
        },
        {
          "label": "No response",
          "value": "no response"
        },
        {
          "label": "Urgent clinical need",
          "value": "urgent clinical need"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "form-handle-payment-failure",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
