# IDE
.idea/
*.iml
.vscode/

# Java build output. The package ships the worker source; the jar is rebuilt with
#   mvn -f 04_Java_Worker/pom.xml clean package
04_Java_Worker/target/
*.class

# The worker's embedded database. It is created on first run and rebuilt from scratch by
# 09_Tests_and_Tools/PersistenceCheck, so the binary belongs in no one's checkout.
data/
*.mv.db
*.trace.db

# Node helpers used only by the rendering/verification scripts
node_modules/

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# NOTE: 05_Test_Evidence/verification/*.log is delivered evidence and must be
# committed, not ignored, even though verify-all.ps1 also writes new logs there.

# Python bytecode from the verification scripts
__pycache__/
*.pyc


# Camunda Modeler conflict copies and stray pid files
*.modelerclobber.bak
*.pid

