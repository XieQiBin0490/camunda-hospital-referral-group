{
  "schemaVersion": 19,
  "components": [
    {
      "type": "text",
      "text": "# Determine whether the payment should be retained, transferred or refunded",
      "id": "Header_form-refund-decision",
      "layout": {
        "row": "Row_0",
        "columns": null
      }
    },
    {
      "key": "patientId",
      "label": "Patient identifier",
      "type": "textfield",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]{2,39}$",
        "required": true
      }
    },
    {
      "type": "select",
      "key": "refundDecision",
      "label": "Decision taken on the payment",
      "values": [
        {
          "label": "Retained by the hospital",
          "value": "retained"
        },
        {
          "label": "Transferred to another episode",
          "value": "transferred"
        },
        {
          "label": "Refunded to the patient",
          "value": "refunded"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "type": "number",
      "key": "refundAmount",
      "label": "Amount to refund, in whole GBP",
      "validate": {
        "min": 0
      }
    }
  ],
  "type": "default",
  "id": "form-refund-decision",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0"
}
